<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
	  <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <SupportedCultures>en-US;it-IT</SupportedCultures>
    <DefaultCulture>en-US</DefaultCulture>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <BitButilTrimScripts>false</BitButilTrimScripts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bit.Brouter" Version="10.6.2" />
    <PackageReference Include="Bit.Butil" Version="10.6.2" />
    <PackageReference Include="Bit.Minifier" Version="10.6.2" PrivateAssets="all" />
    <PackageReference Include="BlazorBlueprint.Components" Version="4.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Refit" Version="16.3.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.3.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The changelog lives in docs/ but has to be reachable as a plain static
      file. In development the server resolves static web assets against
      src/Client/wwwroot, and the manifest is built from whatever existed at
      build time: a file that only appears in the output resolved to nothing
      and came back as an empty 200, leaving the page blank with nothing to
      scroll. Declaring it as Content keeps the publish path working from a
      fresh clone; the target below puts the real file in wwwroot so
      development serves the same bytes. Remove keeps the SDK's implicit
      wwwroot glob from claiming it a second time.
    -->
    <Content Remove="wwwroot\changelog.md" />
    <Content Include="..\..\docs\CHANGELOG.md" Link="wwwroot\changelog.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyChangelogToWwwroot" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\..\docs\CHANGELOG.md"
          DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\changelog.md"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.it.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
