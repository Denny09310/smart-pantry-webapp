@namespace Client.Components
@inject LocalizationService Loc

<div class="sheet-scroll space-y-4">
    @if (Loading)
    {
        <div class="space-y-3" aria-hidden="true">
            <BbSkeleton Height="180px" Class="w-full rounded-xl" />
            <BbSkeleton Height="22px" Class="w-3/4" />
            <div class="flex gap-1.5">
                <BbSkeleton Height="22px" Class="w-16 rounded-full" />
                <BbSkeleton Height="22px" Class="w-20 rounded-full" />
            </div>
            <BbSkeleton Height="120px" Class="w-full rounded-xl" />
        </div>
    }
    else if (Meal is { } meal)
    {
        <figure class="bg-card overflow-hidden rounded-xl border">
            @if (!string.IsNullOrWhiteSpace(meal.Thumbnail))
            {
                <img src="@meal.Thumbnail" alt="" class="aspect-video w-full object-cover" />
            }
            <figcaption class="space-y-1.5 p-4">
                <h3 class="text-lg font-semibold leading-snug">@DisplayName(meal)</h3>
                @if (meal.TranslatedName is not null)
                {
                    <p class="text-sm text-muted-foreground">@meal.Name</p>
                }
                <div class="flex flex-wrap gap-1.5 pt-1">
                    @if (!string.IsNullOrWhiteSpace(meal.Area))
                    {
                        <BbBadge Variant="BadgeVariant.Outline">@meal.Area</BbBadge>
                    }
                    @if (!string.IsNullOrWhiteSpace(meal.Category))
                    {
                        <BbBadge Variant="BadgeVariant.Outline">@meal.Category</BbBadge>
                    }
                    <BbBadge Variant="BadgeVariant.Secondary">
                        @meal.Ingredients.Count @Loc["RecipeIngredients"]
                    </BbBadge>
                </div>
            </figcaption>
        </figure>

        @if (meal.Ingredients.Count > 0)
        {
            <section class="bg-card rounded-xl border p-4">
                <h4 class="mb-2 text-sm font-medium text-muted-foreground uppercase tracking-wider">
                    @Loc["RecipeIngredients"]
                </h4>
                <ul class="divide-y divide-border text-sm">
                    @foreach (var ingredient in meal.Ingredients)
                    {
                        <li class="flex items-baseline justify-between gap-3 py-2">
                            <span class="font-medium">@ingredient.Name</span>
                            @if (!string.IsNullOrWhiteSpace(ingredient.Measure))
                            {
                                <span class="shrink-0 text-muted-foreground">@ingredient.Measure</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(meal.Instructions))
        {
            <section class="bg-card rounded-xl border p-4">
                <h4 class="mb-2 text-sm font-medium text-muted-foreground uppercase tracking-wider">
                    @Loc["RecipeInstructions"]
                </h4>
                <p class="text-sm leading-relaxed whitespace-pre-line">@meal.Instructions</p>
            </section>
        }
    }
    else
    {
        <div role="alert" class="space-y-2 rounded-xl border p-4 text-center">
            <p class="text-sm">@Loc["SearchRecipesFailed"]</p>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="OnRetry">
                @Loc["Retry"]
            </BbButton>
        </div>
    }
</div>

@code
{
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RecipeDetailDto? Meal { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    private string DisplayName(RecipeDetailDto meal) => meal.TranslatedName ?? meal.Name;
}