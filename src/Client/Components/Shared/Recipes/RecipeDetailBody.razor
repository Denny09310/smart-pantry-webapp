@namespace Client.Components
@inject ServerApi Api
@inject ToastService Toasts
@inject LocalizationService Loc

<SheetHeader Title="@Loc["Recipes"]" />
<RecipeDetailContent Loading="_loading"
                     Meal="_meal"
                     OnRetry="LoadAsync" />

@code
{
    [Parameter]
    public string MealId { get; set; } = "";

    private RecipeDetailDto? _meal;
    private bool _loading = true;
    private string _loadedId = "";

    private string Lang => Loc.CurrentCulture.TwoLetterISOLanguageName;

    protected override async Task OnParametersSetAsync()
    {
        if (MealId == _loadedId)
            return;

        _loadedId = MealId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _meal = null;
        try
        {
            var response = await Api.Recipes.GetAsync(MealId, Lang);
            if (response.IsSuccessfulWithContent && response.Content is { } content)
            {
                _meal = content;
            }
            else
            {
                Toasts.Error(Loc["SearchRecipesFailed"]);
            }
        }
        catch
        {
            Toasts.Error(Loc["SearchRecipesFailed"]);
        }
        finally
        {
            _loading = false;
        }
    }
}