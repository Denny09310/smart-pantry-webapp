@namespace Client.Components.Shared.Pantry
@inject ServerApi Api
@inject ToastService Toast
@inject IStringLocalizer<UIStrings> L
@inject Bit.Butil.MediaDevices MediaDevices
@inject Bit.Butil.BarcodeDetector BarcodeDetector
@inject Bit.Butil.Navigator Navigator
@inject ILogger<BarcodeScannerView> Log
@implements IAsyncDisposable

@if (!_checked)
{
    <div class="flex justify-center py-8">
        <BbSpinner Size="SpinnerSize.Default" />
    </div>
}
else if (_camera)
{
    <div class="space-y-3">
        <video @ref="_video" autoplay playsinline muted aria-label="@L["Bc_PreviewAria"]" class="aspect-[4/3] w-full rounded-lg bg-muted object-cover"></video>
        <p class="text-center text-xs text-muted-foreground">@L["Bc_PointHint"]</p>
        @if (_lookingUp)
        {
            <div class="flex flex-col items-center gap-2 py-2" aria-live="polite">
                <BbSpinner Size="SpinnerSize.Default" />
                <p class="text-center text-xs text-muted-foreground">@L["Bc_LookingUp"]</p>
            </div>
        }
        @if (_notFound)
        {
            <div class="space-y-2">
                <p class="text-center text-sm">@L["Bc_NotFound"]</p>
                <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="RestartScanAsync">
                    @L["Bc_ScanAgain"]
                </BbButton>
            </div>
        }
        <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick="CancelAsync">
            @L["Common_Back"]
        </BbButton>
    </div>
}
else
{
    <div class="space-y-3">
        <p class="text-sm text-muted-foreground">@L["Bc_NoCamera"]</p>
        <BbInputGroup Class="bg-card">
            <BbInputGroupInput @bind-Value="_manualCode" Placeholder="e.g. 5449000000996"
                               UpdateTiming="UpdateTiming.Immediate" inputmode="numeric"
                               AriaLabel="@L["Bc_ManualAria"]" />
        </BbInputGroup>
        <BbButton Class="w-full" Loading="@_lookingUp" OnClick="LookupManualAsync">
            @L["Bc_Lookup"]
        </BbButton>
        <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick="CancelAsync">
            @L["Common_Back"]
        </BbButton>
    </div>
}

@code {
    [Parameter]
    public EventCallback<ProductLookupDto> OnScanned { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private static readonly string[] WantedFormats = ["ean_13", "ean_8", "upc_a", "upc_e"];

    private bool _checked;
    private bool _camera;
    private bool _lookingUp;
    private bool _notFound;
    private string? _manualCode;
    private string[] _formats = [];

    private ElementReference _video;
    private Bit.Butil.MediaStreamHandle? _stream;
    private Bit.Butil.ButilSubscription? _scan;
    private bool _started;
    private bool _starting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
            return;

        _started = true;

        try
        {
            if (await BarcodeDetector.IsSupported())
            {
                var supported = await BarcodeDetector.GetSupportedFormats();
                _formats = WantedFormats.Intersect(supported).ToArray();

                if (_formats.Length > 0)
                    _camera = true;
            }
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Barcode support check failed.");
        }

        _checked = true;
        StateHasChanged();

        if (_camera)
            await StartCameraAsync();
    }

    private async Task StartCameraAsync()
    {
        if (_starting)
            return;

        _starting = true;

        try
        {
            await StopCameraAsync();
            _notFound = false;

            try
            {
                // Ask for HD with continuous autofocus: the defaults are often
                // 640x480, which looks blurry stretched full-width and starves
                // the detector of pixels. All ideals, so weaker cameras still
                // start instead of failing constraint resolution (null).
                _stream = await MediaDevices.GetUserMedia(
                    audio: false,
                    video: true,
                    videoConstraints: new
                    {
                        facingMode = "environment",
                        width = new { ideal = 1920 },
                        height = new { ideal = 1080 },
                        focusMode = "continuous",
                    });

                if (_stream is null)
                {
                    _camera = false;
                    return;
                }

                await _stream.AttachTo(_video);

                _scan = await BarcodeDetector.StartScan(
                    _video,
                    onDetected: codes => InvokeAsync(() => HandleDetectedAsync(codes)),
                    formats: _formats,
                    intervalMs: 250);
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "Camera start failed.");
                _camera = false;
            }
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task HandleDetectedAsync(Bit.Butil.DetectedBarcode[] codes)
    {
        var code = codes.FirstOrDefault()?.RawValue;

        if (string.IsNullOrWhiteSpace(code) || _lookingUp)
            return;

        // Stop the scan on first detection: the poll fires repeatedly
        // while a code stays in view.
        if (_scan is not null)
            await _scan.DisposeAsync();
        _scan = null;

        // Tactile ack on phones; silent no-op where unsupported.
        try
        {
            await Navigator.Vibrate([50]);
        }
        catch (Exception ex)
        {
            Log.LogDebug(ex, "Detection vibration failed.");
        }

        await LookupAsync(code.Trim());
    }

    private async Task LookupManualAsync()
    {
        if (string.IsNullOrWhiteSpace(_manualCode))
            return;

        await LookupAsync(_manualCode.Trim());
    }

    private async Task LookupAsync(string barcode)
    {
        _lookingUp = true;
        _notFound = false;
        StateHasChanged();

        try
        {
            using var response = await Api.Products.LookupAsync(barcode);

            if (response.IsSuccessfulWithContent)
            {
                await StopCameraAsync();
                await OnScanned.InvokeAsync(response.Content);
                return;
            }

            _notFound = true;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Product lookup failed.");
            Toast.Error(L["Bc_LookupFailed"]);
        }
        finally
        {
            _lookingUp = false;
            StateHasChanged();
        }
    }

    private Task RestartScanAsync() => StartCameraAsync();

    private async Task CancelAsync()
    {
        await StopCameraAsync();
        await OnCancelled.InvokeAsync();
    }

    private async Task StopCameraAsync()
    {
        try
        {
            if (_scan is not null)
                await _scan.DisposeAsync();
            _scan = null;

            if (_stream is not null)
                await _stream.DisposeAsync();
            _stream = null;
        }
        catch (JSDisconnectedException)
        {
            _scan = null;
            _stream = null;
        }
    }

    public async ValueTask DisposeAsync() => await StopCameraAsync();
}
