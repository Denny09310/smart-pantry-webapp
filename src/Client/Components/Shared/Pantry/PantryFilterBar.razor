@namespace Client.Components.Shared.Pantry
@using Client.Components.Shared.Members
@inject MemberService Members
@inject BottomSheetService BottomSheet
@inject IStringLocalizer<UIStrings> L
@implements IDisposable

<div class="space-y-2">
    <div class="flex gap-2">
        <BbInputGroup Class="flex-1">
            <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                <LucideIcon Name="search" Size="16" />
            </BbInputGroupAddon>
            <BbInputGroupInput Value="@Search"
                               ValueChanged="@OnSearchValueChanged"
                               UpdateTiming="UpdateTiming.Immediate"
                               DebounceInterval="250"
                               Placeholder="@L["Common_SearchPlaceholder"]"
                               AriaLabel="@L["Common_SearchAria"]" />
        </BbInputGroup>
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Class="shrink-0 md:hidden"
                  AriaLabel="@L["Common_SwitchMemberAria"]" OnClick="SwitchMemberAsync">
            <BbAvatar Class="h-6 w-6">
                <BbAvatarFallback Class="text-[10px]"
                                  style="@($"background-color: {Members.CurrentMember?.Color ?? MemberDisplay.DefaultColor}; color: {MemberDisplay.ForegroundFor(Members.CurrentMember?.Color)}")">
                    @(Members.CurrentMember is { } current ? MemberDisplay.Initials(current.Name) : "?")
                </BbAvatarFallback>
            </BbAvatar>
        </BbButton>
        <BbButton OnClick="@(() => OnAdd.InvokeAsync())" Class="shrink-0" AriaLabel="@L["Common_AddItemAria"]">
            <LucideIcon Name="plus" Size="14" />
            <span class="hidden md:inline">@L["Common_AddItem"]</span>
        </BbButton>
        <div class="shrink-0 md:hidden">
            <LanguageSwitcher />
        </div>
    </div>

    <BbChipSet TValue="PantryStatusFilter" Value="@Status" ValueChanged="@OnStatusValueChanged" Wrap="false" Class="scrollbar-none!">
        <BbChip Value="@PantryStatusFilter.All">@L["Common_FilterAll", TotalCount]</BbChip>
        <BbChip Value="@PantryStatusFilter.Soon">@L["Common_FilterSoon", SoonCount]</BbChip>
        <BbChip Value="@PantryStatusFilter.Today">@L["Common_FilterToday", TodayCount]</BbChip>
        <BbChip Value="@PantryStatusFilter.Expired">@L["Common_FilterExpired", ExpiredCount]</BbChip>
        <BbChip Value="@PantryStatusFilter.Fresh">@L["Common_FilterFresh", FreshCount]</BbChip>
    </BbChipSet>

    <BbChipSet TValue="string" Value="@Location" ValueChanged="@OnLocationValueChanged" Wrap="false" Class="scrollbar-none!">
        <BbChip Value="@("all")">@L["Common_FilterAll", TotalCount]</BbChip>
        @foreach (var location in Locations)
        {
            <BbChip Value="@location">@L["Pl_LocCount", DisplayName(location), LocationCount(location)]</BbChip>
        }
    </BbChipSet>
</div>

@code {
    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public EventCallback<string?> SearchChanged { get; set; }

    [Parameter]
    public string? Location { get; set; } = "all";

    [Parameter]
    public EventCallback<string?> LocationChanged { get; set; }

    [Parameter]
    public PantryStatusFilter Status { get; set; } = PantryStatusFilter.All;

    [Parameter]
    public EventCallback<PantryStatusFilter> StatusChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> Locations { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, int> LocationCounts { get; set; } = new Dictionary<string, int>();

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public int SoonCount { get; set; }

    [Parameter]
    public int TodayCount { get; set; }

    [Parameter]
    public int ExpiredCount { get; set; }

    [Parameter]
    public int FreshCount { get; set; }

    [Parameter]
    public EventCallback OnAdd { get; set; }

    private DialogOpenOptions SwitcherOptions() => new()
    {
        Title = L["Common_SwitcherTitle"],
        Description = L["Common_SwitcherDescription"],
        Size = DialogSize.Small
    };

    protected override void OnInitialized() => Members.Changed += OnChanged;

    public void Dispose() => Members.Changed -= OnChanged;

    private async void OnChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Member switched during navigation/dispose; nothing to render.
        }
    }

    private Task SwitchMemberAsync() => BottomSheet.OpenAsync<MemberSwitcher>(SwitcherOptions());

    private Task OnSearchValueChanged(string? value) => SearchChanged.InvokeAsync(value);

    private Task OnLocationValueChanged(string? value) => LocationChanged.InvokeAsync(value ?? "all");

    private Task OnStatusValueChanged(PantryStatusFilter value) => StatusChanged.InvokeAsync(value);

    private int LocationCount(string location)
        => LocationCounts.TryGetValue(location, out var count) ? count : 0;

    private static string DisplayName(string location)
        => string.IsNullOrEmpty(location)
            ? location
            : char.ToUpperInvariant(location[0]) + location[1..];
}
