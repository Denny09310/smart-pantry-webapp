@namespace Client.Components.Shared.Pantry

@inject BottomSheetService BottomSheet
@inject IJSRuntime JS

<Virtualize ItemsProvider="@ProvideItemsAsync" ItemSize="104" OverscanCount="4" @ref="_virtualize">
    <ItemContent Context="item">
        <div id="@($"pantry-item-{item.Id}")" class="@(item.Id == HighlightId ? "rounded-xl bg-muted" : "")">
        <LongPressSurface T="PantryItemDto" Value="item" OnLongPress="OpenActionsAsync">
            <BbCard Class="mb-2">
                <BbCardContent Class="flex items-center gap-3 p-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="truncate text-sm font-semibold">@item.Name</p>
                            <BbBadge Variant="@item.GetBadgeVariant()" Class="shrink-0">@item.GetLabel()</BbBadge>
                        </div>
                        <p class="truncate text-xs text-muted-foreground">
                            @item.FormatQuantity()@(!string.IsNullOrWhiteSpace(item.Notes) ? $" • {item.Notes}" : null)
                        </p>
                        <div class="mt-1 flex items-center justify-between gap-2">
                            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIcon Name="package" Size="12" />
                                @item.GetDisplayLocation()
                            </span>
                            <span
                                class="text-xs @(IsUrgent(item) ? "font-medium text-destructive" : "text-muted-foreground")">
                                @ExpiryText(item)
                            </span>
                        </div>
                    </div>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" Class="shrink-0 rounded-full"
                              AriaLabel="@($"Mark {item.Name} as used")" Loading="@IsBusy(item)"
                              OnClick="@(() => OnCheck.InvokeAsync(item))">
                        <LucideIcon Name="check" Size="16" />
                    </BbButton>
                </BbCardContent>
            </BbCard>
        </LongPressSurface>
        </div>
    </ItemContent>
    <Placeholder>
        <div class="h-[92px] animate-pulse rounded-lg bg-muted"></div>
        <div class="h-[92px] animate-pulse rounded-lg bg-muted"></div>
        <div class="h-[92px] animate-pulse rounded-lg bg-muted"></div>
    </Placeholder>
</Virtualize>

@code
{
    [Parameter]
    public IReadOnlyList<PantryItemDto> Items { get; set; } = [];

    [Parameter]
    public EventCallback<PantryItemDto> OnCheck { get; set; }

    [Parameter]
    public EventCallback<PantryItemDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<PantryItemDto> OnDelete { get; set; }

    [Parameter]
    public IReadOnlyCollection<string> BusyIds { get; set; } = [];

    [Parameter]
    public string? HighlightId { get; set; }

    private static readonly DialogOpenOptions Options = new()
    {
        Title = "Pantry item actions",
        Description = "Select what you want to do with this item"
    };

    private Virtualize<PantryItemDto>? _virtualize;
    private IReadOnlyList<PantryItemDto>? _renderedItems;
    private bool _refreshPending;
    private string? _scrolledFor;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_renderedItems, Items))
        {
            _renderedItems = Items;
            _refreshPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refreshPending && !firstRender && _virtualize is not null)
        {
            _refreshPending = false;
            await _virtualize.RefreshDataAsync();
            StateHasChanged();
        }
        else if (HighlightId is not null && HighlightId != _scrolledFor)
        {
            _scrolledFor = HighlightId;
            await PantryScroll.ScrollToAsync(JS, HighlightId);
        }
    }

    private ValueTask<ItemsProviderResult<PantryItemDto>> ProvideItemsAsync(ItemsProviderRequest request)
    {
        var page = Items.Skip(request.StartIndex).Take(request.Count).ToList();
        return ValueTask.FromResult(new ItemsProviderResult<PantryItemDto>(page, Items.Count));
    }

    private bool IsBusy(PantryItemDto item) => BusyIds.Contains(item.Id);

    private static bool IsUrgent(PantryItemDto item)
        => item.GetStatus() is PantryItemStatus.Expired or PantryItemStatus.Today;

    private static string ExpiryText(PantryItemDto item) => item.GetStatus() switch
    {
        PantryItemStatus.Expired => item.DaysRemaining() == -1
            ? "Expired yesterday"
            : $"Expired {-item.DaysRemaining()} days ago",
        PantryItemStatus.Today => "Use by 11:59 PM",
        _ => item.ExpirationDate.ToString("MMM dd", System.Globalization.CultureInfo.InvariantCulture),
    };

    private async Task OpenActionsAsync(PantryItemDto item)
    {
        var result = await BottomSheet.OpenAsync<PantryItemActionsDialog>(
            parameters: new Dictionary<string, object?>
            {
                [nameof(PantryItemActionsDialog.Item)] = item
            },
            Options);

        if (result.Cancelled)
            return;

        var action = result.GetData<PantryItemActionsDialog.Result>();

        switch (action)
        {
            case PantryItemActionsDialog.Result.Edit:
                await OnEdit.InvokeAsync(item);
                break;

            case PantryItemActionsDialog.Result.Delete:
                await OnDelete.InvokeAsync(item);
                break;
        }
    }
}
