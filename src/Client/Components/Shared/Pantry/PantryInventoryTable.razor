@namespace Client.Components.Shared.Pantry
@using DataGridPrimitives = BlazorBlueprint.Primitives.DataGrid

<BbCard>
    <BbDataGrid TData="PantryItemDto" ItemsProvider="@ProvidePageAsync" ShowPagination="true" InitialPageSize="10"
                TableContainerClass="overflow-x-auto" AriaLabel="Pantry inventory" @ref="_grid">
        <Columns>
            <BbDataGridTemplateColumn TData="PantryItemDto" Title="Item Name">
                <ChildContent Context="item">
                    <span class="font-medium">@item.Name</span>
                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <span class="block truncate text-xs text-muted-foreground">@item.Notes</span>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="PantryItemDto" Title="Quantity">
                <ChildContent Context="item">
                    <span class="text-muted-foreground">@item.FormatQuantity()</span>
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="PantryItemDto" Title="Location">
                <ChildContent Context="item">
                    <BbBadge Variant="BadgeVariant.Outline">@item.GetDisplayLocation()</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="PantryItemDto" Title="Expiration Date" Sortable="true"
                                      SortBy="@(i => i.ExpirationDate)">
                <ChildContent Context="item">
                    <span class="text-muted-foreground">@item.FormatExpiration()</span>
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="PantryItemDto" Title="Status">
                <ChildContent Context="item">
                    <BbBadge Variant="@item.GetBadgeVariant()">@item.GetLabel()</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="PantryItemDto" Title="Actions">
                <ChildContent Context="item">
                    <span class="inline-flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                  AriaLabel="@($"Edit {item.Name}")" Loading="@IsBusy(item)"
                                  OnClick="@(() => OnEdit.InvokeAsync(item))">
                            <LucideIcon Name="pencil" Size="14" />
                            Edit
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="text-destructive"
                                  AriaLabel="@($"Delete {item.Name}")" Loading="@IsBusy(item)"
                                  OnClick="@(() => OnDelete.InvokeAsync(item))">
                            <LucideIcon Name="trash-2" Size="14" />
                            Delete
                        </BbButton>
                    </span>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</BbCard>

@code
{
    [Parameter]
    public IReadOnlyList<PantryItemDto> Items { get; set; } = [];

    [Parameter]
    public EventCallback<PantryItemDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<PantryItemDto> OnDelete { get; set; }

    [Parameter]
    public IReadOnlyCollection<string> BusyIds { get; set; } = [];

    private BbDataGrid<PantryItemDto>? _grid;
    private IReadOnlyList<PantryItemDto>? _renderedItems;
    private bool _refreshPending;

    protected override void OnParametersSet()
    {
        // The grid detects data changes by collection reference. This component
        // otherwise forwards the identical reference it received, so nudge the
        // grid explicitly whenever a new collection arrives.
        if (!ReferenceEquals(_renderedItems, Items))
        {
            _renderedItems = Items;
            _refreshPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // No first-render skip: the grid mounts its own initial query, and a
        // skipped flag would fire spuriously on the next unrelated render.
        if (_refreshPending)
        {
            _refreshPending = false;
            if (_grid is not null)
                await _grid.RefreshDataAsync();
        }
    }

    private bool IsBusy(PantryItemDto item) => BusyIds.Contains(item.Id);

    private ValueTask<DataGridPrimitives.DataGridResult<PantryItemDto>> ProvidePageAsync(DataGridPrimitives.DataGridRequest request)
    {
        request.CancellationToken.ThrowIfCancellationRequested();

        var sorted = ApplyRequestSort(Items, request.SortDefinitions);
        var page = sorted.Skip(request.StartIndex).Take(request.Count ?? sorted.Count).ToList();

        return ValueTask.FromResult(new DataGridPrimitives.DataGridResult<PantryItemDto>
        {
            Items = page,
            TotalItemCount = sorted.Count,
        });
    }

    private static List<PantryItemDto> ApplyRequestSort(IReadOnlyList<PantryItemDto> source, IReadOnlyList<DataGridPrimitives.SortDefinition> sorts)
    {
        // Only the expiration column is sortable, so any user sort targets it.
        if (sorts is not [{ Direction: var direction }, ..])
            return source.ToList();

        return direction == SortDirection.Descending
            ? source.OrderByDescending(i => i.ExpirationDate).ToList()
            : source.OrderBy(i => i.ExpirationDate).ToList();
    }
}
