@inject Bit.Butil.ServiceWorker Worker
@inject NavigationManager Nav
@inject ToastService Toast
@inject IStringLocalizer<UIStrings> L
@inject ILogger<UpdateNotifier> Log
@implements IAsyncDisposable

@code {
    // How often to look for a newly arrived worker while the page stays open.
    // (Full page loads already trigger the browser's own update check.)
    private static readonly TimeSpan PollInterval = TimeSpan.FromMinutes(5);

    private Bit.Butil.ButilSubscription? _controllerChange;
    private CancellationTokenSource? _pollCts;
    private bool _toastShown;
    private bool _started;
    private bool _reloading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
            return;

        _started = true;

        try
        {
            if (!await Worker.IsSupported())
                return;

            _controllerChange = await Worker.SubscribeControllerChange(OnControllerChange);

            await CheckForUpdateAsync();

            _pollCts = new CancellationTokenSource();
            _ = PollForUpdatesAsync(_pollCts.Token);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Update check setup failed.");
        }
    }

    private async Task PollForUpdatesAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);

            while (await timer.WaitForNextTickAsync(token))
                await CheckForUpdateAsync();
        }
        catch (OperationCanceledException)
        {
            // Component torn down; polling stops.
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Update polling failed.");
        }
    }

    private async Task CheckForUpdateAsync()
    {
        try
        {
            // The worker is registered by index.html at page load; here we only
            // ask whether an update check finds something new, then look for a
            // worker parked in waiting.
            await Worker.Update();

            var registration = await Worker.GetRegistration();

            if (registration.IsRegistered && registration.WaitingState is not null)
                await ShowUpdateToastAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Update check failed.");
        }
    }

    private async void OnControllerChange()
    {
        try
        {
            await InvokeAsync(ReloadAsync);
        }
        catch (Exception)
        {
            // Page is going away; nothing left to render.
        }
    }

    private Task ReloadAsync()
    {
        if (_reloading)
            return Task.CompletedTask;

        _reloading = true;
        Nav.NavigateTo(Nav.Uri, forceLoad: true);

        return Task.CompletedTask;
    }

    private async Task ShowUpdateToastAsync()
    {
        if (_toastShown)
            return;

        _toastShown = true;

        await InvokeAsync(() => Toast.Show(new ToastData
        {
            Title = L["Un_UpdateTitle"],
            Description = L["Un_UpdateDescription"],
            Variant = ToastVariant.Info,
            Duration = 0,
            ActionText = L["Un_ReloadButton"],
            OnAction = () => _ = ActivateAsync(),
        }));
    }

    private async Task ActivateAsync()
    {
        try
        {
            await Worker.SkipWaiting();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Update activation failed; reloading.");
        }

        // The click must never die silently: if no controller change arrives
        // (no waiting worker, stuck activation), reload anyway.
        await Task.Delay(4000);
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        // The injected worker service is shared: only the subscription and the
        // polling loop are ours.
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
            _pollCts = null;
        }

        if (_controllerChange is not null)
            await _controllerChange.DisposeAsync();
    }
}
