@namespace Client.Components
@inject Bit.Butil.ServiceWorker Worker
@inject Bit.Butil.Document Document
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ILogger<UpdateNotifier> Logger
@implements IAsyncDisposable

@code
{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _state.Started)
            return;

        _state.Started = true;

        try
        {
            if (!await Worker.IsSupported())
                return;

            _state.Subscription = await Worker.SubscribeControllerChange(OnControllerChange);

            // Full page loads already trigger the browser's own update check.
            await CheckForUpdateAsync();

            // While the app stays open nothing navigates, so no further
            // check would ever run: re-check each time the tab becomes
            // visible again instead of polling on a timer.
            _state.Visibility = await Document.SubscribeVisibilityChange(OnVisibilityChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Update check setup failed.");
        }
    }

    private async void OnVisibilityChanged(Bit.Butil.VisibilityState state)
    {
        try
        {
            if (state != Bit.Butil.VisibilityState.Visible)
                return;

            await InvokeAsync(CheckForUpdateAsync);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task CheckForUpdateAsync()
    {
        if (_state.Checking)
            return;

        _state.Checking = true;

        try
        {
            // The worker is registered by index.html at page load; here we only
            // ask whether an update check finds something new, then look for a
            // worker parked in waiting.
            await Worker.Update();

            var registration = await Worker.GetRegistration();

            if (registration.IsRegistered && registration.WaitingState is not null)
                await ShowUpdateToastAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Update check failed.");
        }
        finally
        {
            _state.Checking = false;
        }
    }

    private async void OnControllerChange()
    {
        try
        {
            await InvokeAsync(ReloadAsync);
        }
        catch (Exception)
        {
            // Page is going away; nothing left to render.
        }
    }

    private Task ReloadAsync()
    {
        if (_state.Reloading)
            return Task.CompletedTask;

        _state.Reloading = true;
        Nav.NavigateTo(Nav.Uri, forceLoad: true);

        return Task.CompletedTask;
    }

    private async Task ShowUpdateToastAsync()
    {
        if (_state.Shown)
            return;

        _state.Shown = true;

        await InvokeAsync(() => Toasts.Show(new ToastData
        {
            Title = "Update available",
            Description = "A new version was downloaded. Reload to use it.",
            Variant = ToastVariant.Info,
            Duration = 0,
            ActionText = "Reload",
            OnAction = () => _ = ActivateAsync(),
        }));
    }

    private async Task ActivateAsync()
    {
        try
        {
            await Worker.SkipWaiting();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Update activation failed; reloading.");
        }

        // The click must never die silently: if no controller change arrives
        // (no waiting worker, stuck activation), reload anyway.
        await Task.Delay(4000);

        if (!_state.Disposed)
            await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _state.Disposed = true;

        if (_state.Visibility is not null)
        {
            try
            {
                await _state.Visibility.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Visibility subscription disposal failed.");
            }
            finally
            {
                _state.Visibility = null;
            }
        }

        if (_state.Subscription is not null)
        {
            try
            {
                await _state.Subscription.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Update subscription disposal failed.");
            }
            finally
            {
                _state.Subscription = null;
            }
        }
    }
}
