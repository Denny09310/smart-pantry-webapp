@inject IJSRuntime JS
@inject ToastService Toast
@inject ILogger<UpdateNotifier> Log
@implements IAsyncDisposable

@code
{
    private BswupUpdateInterop? _interop;
    private DotNetObjectReference<UpdateNotifier>? _instance;
    private bool _toastShown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _interop = new BswupUpdateInterop(JS);
            _instance = DotNetObjectReference.Create(this);
            await _interop.RegisterAsync(_instance);
        }
        catch (JSDisconnectedException)
        {
            // Prerendering / circuit gone; nothing to register.
        }
    }

    [JSInvokable]
    public async Task OnUpdateReady()
    {
        if (_toastShown)
            return;

        _toastShown = true;

        await InvokeAsync(() => Toast.Show(new ToastData
        {
            Title = "Update available",
            Description = "A new version is ready to install.",
            Variant = ToastVariant.Info,
            Duration = 0,
            ActionText = "Reload",
            OnAction = () => _ = ActivateAsync(),
        }));
    }

    private async Task ActivateAsync()
    {
        if (_interop is null)
            return;

        try
        {
            await _interop.ActivateAsync();
        }
        catch (JSDisconnectedException)
        {
            // Page is going away anyway.
        }
        catch (Exception ex)
        {
            // The click must never die silently: log, tell the user,
            // and fall back to a plain reload.
            Log.LogError(ex, "Update activation failed; forcing reload.");
            Toast.Error("Update couldn't activate. Reloading…");

            try
            {
                await _interop.ForceReloadAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_interop is not null)
            await _interop.DisposeAsync();

        _instance?.Dispose();
    }
}
