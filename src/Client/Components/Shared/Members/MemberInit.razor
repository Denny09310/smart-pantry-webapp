@namespace Client.Components.Shared.Members
@inject MemberService Members
@inject ToastService Toast
@inject BottomSheetService BottomSheet

@code {
    private static readonly DialogOpenOptions FirstRunOptions = new()
    {
        Title = "Who's using this pantry?",
        Description = "Create the first member to get started.",
        Size = DialogSize.Small,
    };

    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
            return;

        _started = true;
        await Members.InitializeAsync();

        if (Members.LoadFailed)
        {
            Toast.Error("Can't reach the server. Check your connection and reload.");
            return;
        }

        while (Members.Members.Count == 0 && !Members.LoadFailed)
        {
            var parameters = new Dictionary<string, object?> { [nameof(CreateMemberDialog.AllowCancel)] = false };
            var result = await BottomSheet.OpenAsync<CreateMemberDialog>(parameters, FirstRunOptions);

            // Creation failed server-side: retry instead of entering a memberless app.
            if (result.Cancelled)
                continue;

            break;
        }
    }
}
