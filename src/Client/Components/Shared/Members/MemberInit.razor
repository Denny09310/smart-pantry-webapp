@namespace Client.Components
@inject MemberService Members
@inject ToastService Toasts
@inject BottomSheetService Sheet
@inject LocalizationService Loc

@code
{
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
            return;

        _started = true;
        await Members.InitializeAsync();

        if (Members.LoadFailed)
        {
            Toasts.Error(Loc["MembersLoadFailed"]);
            return;
        }

        while (Members.Members.Count == 0 && !Members.LoadFailed)
        {
            var parameters = new Dictionary<string, object?>
            {
                ["AllowCancel"] = false
            };
            
            var options = new SheetOptions { Dismissible = false };
            var result = await Sheet.OpenAsync<MemberForm>(parameters, options);

            // Creation failed server-side: retry instead of entering a memberless app.
            if (result.Cancelled)
                continue;

            break;
        }
    }
}
