@namespace Client.Components
@using Client.Models
@inject MemberService Members
@inject BottomSheetService Sheet
@inject LocalizationService Loc
@implements IDisposable

<div class="flex h-full flex-col">
    <div class="flex-none">
        <h2 class="text-lg font-semibold">@Loc["HouseholdMembers"]</h2>
        <p class="text-sm text-muted-foreground">@Loc["WhoIsUsing"]</p>
        </div>

        <div class="min-h-0 flex-1 touch-pan-y space-y-1 overflow-y-auto overscroll-contain py-1 pr-1">
            @foreach (var member in Members.ActiveMembers)
            {
                <div @key="member.Id"
                     class="flex items-center gap-3 rounded-lg p-2 @(member.Id == Members.CurrentMemberId ? "bg-secondary" : "")">
                    <MemberAvatar Member="member" WrapperClass="flex-none" />
                    <button type="button" class="min-w-0 flex-1 text-left" @onclick="@(() => SelectAsync(member.Id))">
                        <p class="truncate text-sm font-medium">@member.DisplayName</p>
                        <p class="text-xs text-muted-foreground">
                            @(member.Id == Members.CurrentMemberId ? Loc["Current"] : Loc["TapToSwitch"])
                        </p>
                    </button>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                              AriaLabel="@Loc["RenameUser", member.DisplayName]" OnClick="@(() => RenameAsync(member))">
                        <LucideIcon Name="pencil" Size="16" />
                    </BbButton>
                    @if (Members.ActiveMembers.Count() > 1)
                    {
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                  AriaLabel="@Loc["ArchiveMemberConfirm", member.DisplayName]" OnClick="@(() => ArchiveAsync(member))">
                            <LucideIcon Name="archive" Size="16" />
                        </BbButton>
                    }
                </div>
            }

            @if (Members.Members.Any(m => m.IsArchived))
            {
                <div class="space-y-1 pt-2">
                    <p class="text-xs font-medium uppercase text-muted-foreground">@Loc["Archived"]</p>
                    @foreach (var member in Members.Members.Where(m => m.IsArchived))
                    {
                        <div @key="member.Id" class="flex items-center gap-3 rounded-lg p-2 opacity-60">
                            <BbAvatar>
                                <BbAvatarFallback
                                    style="@($"background-color: {member.Color ?? MemberDisplay.DefaultColor}; color: {MemberDisplay.ForegroundFor(member.Color)}")">
                                    @MemberDisplay.Initials(member.DisplayName)
                                </BbAvatarFallback>
                            </BbAvatar>
                            <p class="min-w-0 flex-1 truncate text-sm font-medium">@member.DisplayName</p>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                      AriaLabel="@Loc["UnarchiveUser", member.DisplayName]" OnClick="@(() => UnarchiveAsync(member))">
                                <LucideIcon Name="archive-restore" Size="16" />
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                      AriaLabel="@Loc["DeleteMemberConfirm", member.DisplayName]" OnClick="@(() => DeleteAsync(member))">
                                <LucideIcon Name="trash-2" Size="16" />
                            </BbButton>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex-none border-t pt-3">
            <BbButton Variant="ButtonVariant.Outline" Class="w-full" Type="ButtonType.Button" OnClick="CreateAsync">
                <LucideIcon Name="plus" Size="16" />
                @Loc["AddMember"]
            </BbButton>
        </div>
    </div>

@code
{
    protected override void OnInitialized()
    {
        Members.Changed += OnMembersChanged;
    }

    public void Dispose()
    {
        Members.Changed -= OnMembersChanged;
    }

    private async void OnMembersChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task SelectAsync(string id)
    {
        await Members.SelectMemberAsync(id);
        await Sheet.CloseAsync(id);
    }

    private async Task CreateAsync()
    {
        await Sheet.OpenAsync<MemberForm>();
        await Sheet.OpenAsync<MemberSwitcher>();
    }

    private async Task RenameAsync(HouseholdMemberDto member)
    {
        await Sheet.OpenAsync<MemberForm>(new Dictionary<string, object?> { ["EditMember"] = member });
        await Sheet.OpenAsync<MemberSwitcher>();
    }

    private async Task ArchiveAsync(HouseholdMemberDto member)
    {
        // Same rule as item deletion: the confirm renders beneath the
        // sheet, so close first and let the opener confirm and archive.
        await Sheet.CloseAsync(member);
    }

    private async Task DeleteAsync(HouseholdMemberDto member)
    {
        // Close first for the same reason; the opener confirms and deletes.
        await Sheet.CloseAsync(new MemberSheetActions.DeleteRequest(member));
    }

    private async Task UnarchiveAsync(HouseholdMemberDto member)
    {
        await Members.UpdateMemberAsync(member.Id, member.DisplayName, member.Color, false);
    }
}
