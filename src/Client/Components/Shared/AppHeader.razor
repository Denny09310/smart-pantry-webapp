@namespace Client.Components.Shared
@inject ToastService Toast
@inject BottomSheetService BottomSheet
@inject MemberService Members
@inject IStringLocalizer<UIStrings> L
@implements IDisposable

<BbResponsiveNavProvider>
    <header class="hidden border-b bg-card md:block" style="view-transition-name: app-header;">
        <div class="mx-auto flex w-full max-w-6xl items-center gap-3 px-4 py-3">
            <span class="inline-flex items-center gap-2 text-base font-semibold">
                <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground">
                    <LucideIcon Name="package" Size="16" />
                </span>
                Smart Pantry
            </span>
            <BbResponsiveNavItems Items="@NavItems" MobileClass="hidden" />
            <span class="flex-1"></span>
            <BbButton Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.IconSmall"
                      AriaLabel="@L["Common_SwitchMemberAria"]"
                      OnClick="SwitchMemberAsync">
                <BbAvatar Class="h-6 w-6">
                    <BbAvatarFallback Class="text-[10px]"
                                      style="@($"background-color: {Members.CurrentMember?.Color ?? MemberDisplay.DefaultColor}; color: {MemberDisplay.ForegroundFor(Members.CurrentMember?.Color)}")">
                        @(Members.CurrentMember is { } current ? MemberDisplay.Initials(current.Name) : "?")
                    </BbAvatarFallback>
                </BbAvatar>
            </BbButton>
            <BbButton Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.IconSmall"
                      AriaLabel="@L["Common_NotificationsTitle"]"
                      OnClick="NotifyAsync">
                <LucideIcon Name="bell" Size="18" />
            </BbButton>
        </div>
    </header>
</BbResponsiveNavProvider>

@code {
    private IReadOnlyList<NavItemDefinition> NavItems =>
    [
        new() { Text = L["Nav_Dashboard"], Href = "/", Match = NavLinkMatch.All },
        new() { Text = L["Nav_Pantry"], Href = "/pantry" },
        new() { Text = L["Settings_Title"], Href = "/settings" },
    ];

    private DialogOpenOptions NotificationsOptions() => new()
    {
        Title = L["Common_NotificationsTitle"],
        Description = L["Common_NotificationsDescription"],
        Size = DialogSize.Default,
    };

    private DialogOpenOptions SwitcherOptions() => new()
    {
        Title = L["Common_SwitcherTitle"],
        Description = L["Common_SwitcherDescription"],
        Size = DialogSize.Small,
    };

    protected override void OnInitialized() => Members.Changed += OnChanged;

    public void Dispose() => Members.Changed -= OnChanged;

    private async void OnChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Member switched during navigation/dispose; nothing to render.
        }
    }

    private Task NotifyAsync() => BottomSheet.OpenAsync<NotificationsPanel>(NotificationsOptions());

    private Task SwitchMemberAsync() => BottomSheet.OpenAsync<MemberSwitcher>(SwitcherOptions());
}
