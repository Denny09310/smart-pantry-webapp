@namespace Client.Components
@using Client.Resources
@inject LocalizationService Loc

<nav aria-label="@Loc["BbSidebarNav"]"
     class="fixed inset-x-4 bottom-4 pb-[env(safe-area-inset-bottom)] z-30 rounded-2xl border bg-background/95 backdrop-blur shadow-lg md:hidden"
     style="view-transition-name: bottom-nav;">
    <div class="flex justify-evenly gap-4 p-2">
        <NavLink href="/" Match="NavLinkMatch.All" ActiveClass="@ActiveTokens" class="@BaseTokens"
                 title="@Loc["Pantry"]">
            <LucideIcon Name="package" Size="24" />
        </NavLink>
        <NavLink href="/recipes" ActiveClass="@ActiveTokens" class="@BaseTokens" title="@Loc["Recipes"]">
            <LucideIcon Name="chef-hat" Size="24" />
        </NavLink>
        <NavLink href="/settings" ActiveClass="@ActiveTokens" class="@BaseTokens" title="@Loc["Settings"]">
            <LucideIcon Name="settings" Size="24" />
        </NavLink>
    </div>
</nav>

@code
{
    private const string BaseTokens =
        "flex min-h-12 min-w-12 flex-col items-center justify-center gap-1 rounded-xl " +
        "hover:bg-primary/10 focus-visible:ring-2 focus-visible:ring-ring";

    private const string ActiveTokens = "bg-primary/10 text-primary";
}