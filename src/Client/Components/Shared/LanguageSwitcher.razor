@namespace Client.Components.Shared
@inject LanguageService Languages
@inject IStringLocalizer<UIStrings> L

<div class="flex shrink-0 items-center gap-1" role="group" aria-label="@L["Lang_SwitchAria"]">
    @foreach (var language in UIStrings.SupportedLanguages)
    {
        <BbButton Variant="@(IsActive(language) ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                  Size="ButtonSize.IconSmall"
                  AriaLabel="@L["Lang_SwitchAria"]"
                  OnClick="@(() => SwitchAsync(language))">
            <span class="text-[10px] font-semibold">@language.ToUpperInvariant()</span>
        </BbButton>
    }
</div>

@code {
    private bool IsActive(string language)
        => string.Equals(Languages.Current, language, StringComparison.OrdinalIgnoreCase);

    private Task SwitchAsync(string language)
        => IsActive(language) ? Task.CompletedTask : Languages.SetAsync(language);
}
