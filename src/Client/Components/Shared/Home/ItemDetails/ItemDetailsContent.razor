@namespace Client.Components
@inject LocalizationService Loc
@inject BottomSheetService Sheet
@inject ToastService Toasts

<div class="sheet-scroll space-y-4">
    @if (Loading)
    {
        <div class="space-y-2" aria-hidden="true">
            <BbSkeleton Height="28px" Class="w-2/3" />
            <BbSkeleton Height="16px" Class="w-full" />
            <BbSkeleton Height="16px" Class="w-4/5" />
        </div>
    }
    else if (Error is not null)
    {
        <div role="alert" class="space-y-2 rounded-md border p-4 text-center">
            <p class="text-sm">@Loc["CouldNotLoad"]</p>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="OnRetry">@Loc["Retry"]</BbButton>
        </div>
    }
    else if (Item is null)
    {
        <BbEmpty Title="@Loc["ItemNotFound"]" Description="@Loc["ItemGoneDescription"]">
            <Icon>
                <LucideIcon Name="search" Size="24" />
            </Icon>
        </BbEmpty>
    }
    else
    {
        <header class="space-y-2">
            <h3 class="text-xl font-semibold">@Item.Name</h3>
            <div class="flex flex-wrap gap-2">
                <ExpiryBadge ExpirationDate="Item.ExpirationDate" Today="Today" />
                <BbBadge Variant="BadgeVariant.Outline">@Item.Location</BbBadge>
            </div>
        </header>

        <dl class="space-y-2 rounded-md border p-4 text-sm">
            <div class="flex justify-between gap-2">
                <dt class="text-muted-foreground">@Loc["Quantity"]</dt>
                <dd>@Item.Quantity @Item.Unit</dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-muted-foreground">@Loc["ExpiresOn"]</dt>
                <dd>@Item.ExpirationDate.ToString("MMM d, yyyy")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Item.Notes))
            {
                <div class="space-y-1">
                    <dt class="text-muted-foreground">@Loc["Notes"]</dt>
                    <dd>@Item.Notes</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Barcode))
            {
                <div class="flex items-center justify-between gap-2">
                    <dt class="text-muted-foreground">@Loc["Barcode"]</dt>
                    <dd class="flex items-center gap-1">
                        <span class="font-mono">@Item.Barcode</span>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@Loc["UnlinkBarcode"]"
                                  Loading="Unlinking" OnClick="OnUnlinkBarcode">
                            <LucideIcon Name="unlink" Size="14" />
                        </BbButton>
                    </dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Item.NutriScore))
            {
                <div class="flex items-center justify-between gap-2">
                    <dt class="text-muted-foreground">@Loc["NutriScore"]</dt>
                    <dd>
                        <BbBadge Variant="@NutriScoreVariant">@Item.NutriScore.ToUpperInvariant()</BbBadge>
                    </dd>
                </div>
            }
        </dl>

        @if (NutritionRows is { Count: > 0 } rows)
        {
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@Loc["NutritionPer100g"]</h3>
                <dl class="space-y-2 rounded-md border p-4 text-sm">
                    @foreach (var row in rows)
                    {
                        <div class="flex justify-between gap-2">
                            <dt class="text-muted-foreground">@row.Label</dt>
                            <dd class="font-medium">@row.Value</dd>
                        </div>
                    }
                </dl>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Product?.IngredientsText))
        {
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@Loc["Ingredients"]</h3>
                <p class="text-sm text-muted-foreground">@Product.IngredientsText</p>
            </div>
        }

        @* Barcode backfill for items added before scanning existed *@
        @if (string.IsNullOrWhiteSpace(Item.Barcode) && !LinkingBarcode)
        {
            <BbButton Variant="ButtonVariant.Outline" Class="w-full" Type="ButtonType.Button" OnClick="OnLinkBarcode">
                <LucideIcon Name="scan-barcode" Size="16" />
                @Loc["LinkBarcode"]
            </BbButton>
        }
        @if (LinkingBarcode)
        {
            <div class="space-y-2 rounded-md border p-3">
                <BarcodeScanner OnBarcodeScanned="OnBarcodeScanned" AutoStart="true" />
                <BbButton Variant="ButtonVariant.Ghost" Class="w-full" Type="ButtonType.Button" OnClick="OnCancelLinkBarcode">
                    @Loc["Cancel"]
                </BbButton>
            </div>
        }
    }
</div>

@code
{
    [Parameter, EditorRequired] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public PantryItemDto? Item { get; set; }
    [Parameter] public ProductLookupDto? Product { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public bool LinkingBarcode { get; set; }
    [Parameter] public bool Unlinking { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback OnLinkBarcode { get; set; }
    [Parameter] public EventCallback OnCancelLinkBarcode { get; set; }
    [Parameter] public EventCallback<string> OnBarcodeScanned { get; set; }
    [Parameter] public EventCallback OnUnlinkBarcode { get; set; }

    private BadgeVariant NutriScoreVariant => Item?.NutriScore?.Trim().ToUpperInvariant() switch
    {
        "A" => BadgeVariant.SoftSuccess,
        "B" => BadgeVariant.SoftInfo,
        "C" => BadgeVariant.SoftWarning,
        "D" or "E" => BadgeVariant.SoftDestructive,
        _ => BadgeVariant.Outline,
    };

    private NutritionFacts? _rowsFor;
    private string? _rowsCulture;
    private IReadOnlyList<(string Label, string Value)>? _rowsCache;

    /// <summary>Memoized per nutrition payload + culture (labels localize).</summary>
    private IReadOnlyList<(string Label, string Value)> NutritionRows
    {
        get
        {
            var culture = Loc.CurrentCulture.Name;
            if (_rowsCache is not null && Equals(_rowsFor, Item?.Nutrition) && _rowsCulture == culture)
                return _rowsCache;

            _rowsFor = Item?.Nutrition;
            _rowsCulture = culture;
            return _rowsCache = BuildNutritionRows(_rowsFor);
        }
    }

    private List<(string Label, string Value)> BuildNutritionRows(NutritionFacts? nutrition)
    {
        List<(string Label, string Value)> rows = [];

        if (nutrition is not { })
            return rows;

        if (nutrition.EnergyKcal is { } energy)
            rows.Add((Loc["NutritionEnergy"], $"{energy:0} kcal"));
        if (nutrition.Fat is { } fat)
            rows.Add((Loc["NutritionFat"], $"{fat:0.#} g"));
        if (nutrition.SaturatedFat is { } satFat)
            rows.Add((Loc["NutritionSaturatedFat"], $"{satFat:0.#} g"));
        if (nutrition.Carbohydrates is { } carbs)
            rows.Add((Loc["NutritionCarbs"], $"{carbs:0.#} g"));
        if (nutrition.Sugars is { } sugars)
            rows.Add((Loc["NutritionSugars"], $"{sugars:0.#} g"));
        if (nutrition.Fiber is { } fiber)
            rows.Add((Loc["Fiber"], $"{fiber:0.#} g"));
        if (nutrition.Proteins is { } protein)
            rows.Add((Loc["NutritionProtein"], $"{protein:0.#} g"));
        if (nutrition.Salt is { } salt)
            rows.Add((Loc["NutritionSalt"], $"{salt:0.##} g"));

        return rows;
    }
}