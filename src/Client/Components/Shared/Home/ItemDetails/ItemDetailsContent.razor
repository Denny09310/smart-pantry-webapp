@namespace Client.Components
@inject LocalizationService Loc
@inject BottomSheetService Sheet
@inject ToastService Toasts

<div class="sheet-scroll space-y-4">
    @if (Loading)
    {
        <div class="space-y-2" aria-hidden="true">
            <BbSkeleton Height="28px" Class="w-2/3" />
            <BbSkeleton Height="16px" Class="w-full" />
            <BbSkeleton Height="16px" Class="w-4/5" />
        </div>
    }
    else if (Error is not null)
    {
        <div role="alert" class="space-y-2 rounded-md border p-4 text-center">
            <p class="text-sm">@Loc["CouldNotLoad"]</p>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="OnRetry">@Loc["Retry"]</BbButton>
        </div>
    }
    else if (Item is null)
    {
        <BbEmpty Title="@Loc["ItemNotFound"]" Description="@Loc["ItemGoneDescription"]">
            <Icon>
                <LucideIcon Name="search" Size="24" />
            </Icon>
        </BbEmpty>
    }
    else
    {
        <header class="space-y-2">
            <h3 class="text-xl font-semibold">@Item.Name</h3>
            <div class="flex flex-wrap gap-2">
                <ExpiryBadge ExpiryDate="Item.ExpiryDate" Today="Today" />
                <BbBadge Variant="BadgeVariant.Outline">@Item.Category</BbBadge>
            </div>
        </header>

        <dl class="space-y-2 rounded-md border p-4 text-sm">
            <div class="flex justify-between gap-2">
                <dt class="text-muted-foreground">@Loc["Quantity"]</dt>
                <dd>@Item.Quantity @Item.Unit</dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-muted-foreground">@Loc["ExpiresOn"]</dt>
                <dd>@Item.ExpiryDate.ToString("MMM d, yyyy")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Item.Notes))
            {
                <div class="space-y-1">
                    <dt class="text-muted-foreground">@Loc["Notes"]</dt>
                    <dd>@Item.Notes</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Barcode))
            {
                <div class="flex items-center justify-between gap-2">
                    <dt class="text-muted-foreground">@Loc["Barcode"]</dt>
                    <dd class="flex items-center gap-1">
                        <span class="font-mono">@Item.Barcode</span>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@Loc["UnlinkBarcode"]"
                                  Loading="Unlinking" OnClick="OnUnlinkBarcode">
                            <LucideIcon Name="unlink" Size="14" />
                        </BbButton>
                    </dd>
                </div>
            }
        </dl>

        @if (!string.IsNullOrWhiteSpace(Product?.IngredientsText))
        {
            <div class="space-y-2">
                <h3 class="text-sm font-medium">@Loc["Ingredients"]</h3>
                <p class="text-sm text-muted-foreground">@Product.IngredientsText</p>
            </div>
        }

        @* Barcode backfill for items added before scanning existed *@
        @if (string.IsNullOrWhiteSpace(Item.Barcode) && !LinkingBarcode)
        {
            <BbButton Variant="ButtonVariant.Outline" Class="w-full" Type="ButtonType.Button" OnClick="OnLinkBarcode">
                <LucideIcon Name="scan-barcode" Size="16" />
                @Loc["LinkBarcode"]
            </BbButton>
        }
        @if (LinkingBarcode)
        {
            <div class="space-y-2 rounded-md border p-3">
                <BarcodeScanner OnBarcodeScanned="OnBarcodeScanned" AutoStart="true" />
                <BbButton Variant="ButtonVariant.Ghost" Class="w-full" Type="ButtonType.Button" OnClick="OnCancelLinkBarcode">
                    @Loc["Cancel"]
                </BbButton>
            </div>
        }
    }
</div>

@code
{
    [Parameter, EditorRequired] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public CosmeticItemDto? Item { get; set; }
    [Parameter] public ProductLookupDto? Product { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public bool LinkingBarcode { get; set; }
    [Parameter] public bool Unlinking { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback OnLinkBarcode { get; set; }
    [Parameter] public EventCallback OnCancelLinkBarcode { get; set; }
    [Parameter] public EventCallback<string> OnBarcodeScanned { get; set; }
    [Parameter] public EventCallback OnUnlinkBarcode { get; set; }
}