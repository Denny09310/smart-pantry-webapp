@using System.ComponentModel.DataAnnotations
@using Client.Components.Shared.Pantry
@inject IStringLocalizer<UIStrings> L

@if (_scanning)
{
    <BarcodeScannerView OnScanned="ApplyScanAsync" OnCancelled="CancelScan" />
}
else
{
<EditForm Model="@Input" OnValidSubmit="HandleSubmitAsync" class="flex flex-col overflow-hidden">
    <DataAnnotationsValidator />

    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto overscroll-none pr-1">
        <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="StartScan">
            <LucideIcon Name="barcode" Size="16" />
            @L["Cd_ScanBarcode"]
        </BbButton>
        @* Item name *@
        <BbField IsInvalid="@(!context.IsValid(() => Input.Name))">
            <div class="flex items-center justify-between">
                <BbFieldLabel For="item-name" Class="text-sm font-medium">@L["Cd_ItemNameLabel"]</BbFieldLabel>
                <span class="text-xs text-muted-foreground">@L["Cd_RequiredHint"]</span>
            </div>
            <BbFieldContent>
                <BbInputGroup Class="bg-card">
                    <BbInputGroupInput Id="item-name" @bind-Value="Input.Name"
                                       Placeholder="@L["Cd_ItemNamePlaceholder"]" UpdateTiming="UpdateTiming.Immediate" />
                </BbInputGroup>
                <BbFieldError Errors="@context.GetValidationMessages(() => Input.Name)" />
            </BbFieldContent>
        </BbField>

        @* Quantity & measure *@
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <BbLabel Class="text-sm font-medium">@L["Cd_QuantityMeasureLabel"]</BbLabel>
                <span class="text-xs text-sky-600">@L["Cd_StepCounterHint"]</span>
            </div>

            <div class="flex items-center justify-between rounded-lg bg-muted p-1">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="@L["Cd_DecreaseAria"]"
                          OnClick="DecrementQuantity">
                    <LucideIcon Name="minus" Size="16" />
                </BbButton>
                <div class="flex flex-col items-center leading-none">
                    <span class="text-base font-semibold" aria-live="polite">@Input.Quantity</span>
                    <span class="text-xs text-muted-foreground">@Input.Unit</span>
                </div>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="@L["Cd_IncreaseAria"]"
                          OnClick="IncrementQuantity">
                    <LucideIcon Name="plus" Size="16" />
                </BbButton>
            </div>
            <ValidationMessage For="@(() => Input.Quantity)" class="text-sm text-destructive" />

            <BbChipSet @bind-Value="Input.Unit" Wrap="false" Class="gap-1.5 scrollbar-none!">
                <BbChip Value="@("pcs")">@L["Cd_UnitPcs"]</BbChip>
                <BbChip Value="@("jar")">@L["Cd_UnitJar"]</BbChip>
                <BbChip Value="@("can")">@L["Cd_UnitCan"]</BbChip>
                <BbChip Value="@("box")">@L["Cd_UnitBox"]</BbChip>
                <BbChip Value="@("kg")">@L["Cd_UnitKg"]</BbChip>
                <BbChip Value="@("g")">@L["Cd_UnitGram"]</BbChip>
                <BbChip Value="@("litre")">@L["Cd_UnitLitre"]</BbChip>
            </BbChipSet>
            <ValidationMessage For="@(() => Input.Unit)" class="text-sm text-destructive" />
        </div>

        @* Storage location *@
        <div class="space-y-2">
            <BbLabel Class="text-sm font-medium">@L["Cd_StorageLocationLabel"]</BbLabel>
            <BbToggleGroup @bind-Value="Input.Location" Type="ToggleGroupType.Single" Required="true"
                           Variant="ToggleVariant.Outline" Class="grid grid-cols-4 gap-2">
                <BbToggleGroupItem Value="@("pantry")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="package" Size="20" />
                    <span class="text-xs font-medium">@L["Common_LocationPantry"]</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem Value="@("fridge")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="refrigerator" Size="20" />
                    <span class="text-xs font-medium">@L["Common_LocationFridge"]</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem Value="@("freezer")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="snowflake" Size="20" />
                    <span class="text-xs font-medium">@L["Common_LocationFreezer"]</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem Value="@("cabinet")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="archive" Size="20" />
                    <span class="text-xs font-medium">@L["Common_LocationCabinet"]</span>
                </BbToggleGroupItem>
            </BbToggleGroup>
            <ValidationMessage For="@(() => Input.Location)" class="text-sm text-destructive" />
        </div>

        @* Shelf life & expiry *@
        <BbField>
            <BbFieldLabel Class="text-sm font-medium">@L["Cd_ShelfLifeLabel"]</BbFieldLabel>
            <BbFieldContent>
                <BbDatePicker @bind-Value="Input.ExpirationDate" MinDate="@(_editingId is null ? DateTime.Today : null)" DateFormat="dd/MM/yyyy"
                              Placeholder="@L["Cd_ExpiryPlaceholder"]" Class="w-full" />
                <ValidationMessage For="@(() => Input.ExpirationDate)" class="text-sm text-destructive" />
            </BbFieldContent>
        </BbField>

        <div class="space-y-2">
            <span class="text-xs text-muted-foreground">@L["Cd_AddShortcuts"]</span>
            <div class="flex flex-wrap gap-1.5">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(3))">
                    @L["Cd_Plus3Days"]
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(7))">
                    @L["Cd_Plus1Week"]
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(30))">
                    @L["Cd_Plus1Month"]
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(180))">
                    @L["Cd_Plus6Months"]
                </BbButton>
            </div>
            @if (DaysRemaining is not null)
            {
                <BbBadge Variant="@FreshnessVariant">
                    <BbBadgeIcon Name="info" />
                    @FreshnessText
                </BbBadge>
            }
        </div>

        @* Batch notes *@
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <BbLabel For="batch-notes" Class="text-sm font-medium">@L["Cd_BatchNotesLabel"]</BbLabel>
                <span class="text-xs text-muted-foreground">@L["Cd_OptionalHint"]</span>
            </div>
            <BbTextarea Id="batch-notes" @bind-Value="Input.Notes" Placeholder="@L["Cd_BatchNotesPlaceholder"]"
                        rows="2" />
        </div>

    </div>

    @* Actions *@
    <div class="shrink-0 space-y-1 border-t pt-3">
        <BbButton Type="ButtonType.Submit" Class="w-full" Loading="@_saving" IconPosition="IconPosition.Start">
            <Icon>
                <LucideIcon Name="save" Size="16" />
            </Icon>
            <ChildContent>@(_editingId is null ? L["Cd_SaveItem"] : L["Cd_SaveChanges"])</ChildContent>
        </BbButton>
        <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick="CancelAsync">
            @L["Common_Cancel"]
        </BbButton>
    </div>
</EditForm>
}

@code
{
    [CascadingParameter]
    public IDialogReference Reference { get; set; } = default!;

    /// <summary>When set, the form edits this item instead of creating a new one.</summary>
    [Parameter]
    public PantryItemDto? Item { get; set; }

    private bool _saving;
    private bool _scanning;
    private InputModel Input { get; set; } = new();
    private string? _editingId;

    protected override void OnParametersSet()
    {
        if (Item is { } item && _editingId != item.Id)
        {
            _editingId = item.Id;
            Input = new InputModel
            {
                Name = item.Name,
                Quantity = item.Quantity,
                Unit = item.Unit,
                Location = item.Location,
                Notes = item.Notes,
                ExpirationDate = item.ExpirationDate.ToDateTime(TimeOnly.MinValue),
            };
        }
        else if (Item is null)
        {
            _editingId = null;
        }
    }

    private int? DaysRemaining =>
        Input.ExpirationDate is { } d ? (int?)(d.Date - DateTime.Today).Days : null;

    // Same rule as the server and the lists: no private freshness thresholds.
    private ExpiryStatus? Freshness =>
        Input.ExpirationDate is { } d ? ExpiryStatusCalculator.GetStatus(DateOnly.FromDateTime(d.Date), DateOnly.FromDateTime(DateTime.Today)) : null;

    private string FreshnessText
    {
        get
        {
            // Non-null whenever Freshness is: both derive from ExpirationDate.
            var remaining = DaysRemaining ?? 0;

            return Freshness switch
            {
                null => string.Empty,
                ExpiryStatus.Expired => L["Common_ExpiredDaysAgo", -remaining],
                ExpiryStatus.Today => L["Common_ExpiresToday"],
                ExpiryStatus.Soon => L["Cd_UseSoon", remaining],
                _ => L["Cd_FreshStable", remaining],
            };
        }
    }

    private BadgeVariant FreshnessVariant => Freshness switch
    {
        null => BadgeVariant.SoftInfo,
        ExpiryStatus.Expired => BadgeVariant.SoftDestructive,
        ExpiryStatus.Fresh => BadgeVariant.SoftSuccess,
        _ => BadgeVariant.SoftWarning,
    };

    private void IncrementQuantity()
    {
        if (Input.Quantity < 9999)
            Input.Quantity++;
    }

    private void DecrementQuantity()
    {
        if (Input.Quantity > 1)
            Input.Quantity--;
    }

    private void SetExpiry(int daysFromToday) =>
        Input.ExpirationDate = DateTime.Today.AddDays(daysFromToday);

    private void StartScan() => _scanning = true;

    private void CancelScan() => _scanning = false;

    private void ApplyScanAsync(ProductLookupDto product)
    {
        Input.Name = product.Name;

        var details = string.Join(
            " • ",
            new[] { product.Brand, product.Quantity }.Where(s => !string.IsNullOrWhiteSpace(s)));

        if (!string.IsNullOrWhiteSpace(details))
            Input.Notes = string.IsNullOrWhiteSpace(Input.Notes) ? details : $"{Input.Notes}\n{details}";

        _scanning = false;
    }

    private async Task HandleSubmitAsync()
    {
        if (Input.ExpirationDate is null)
            return;

        _saving = true;
        try
        {
            var request = new CreatePantryItemRequest(
                Input.Name.Trim(),
                Input.Quantity,
                Input.Unit,
                Input.Location,
                string.IsNullOrWhiteSpace(Input.Notes) ? null : Input.Notes.Trim(),
                DateOnly.FromDateTime(Input.ExpirationDate.Value));

            await Reference.CloseAsync(DialogResult.Ok(request));
        }
        finally
        {
            _saving = false;
        }
    }

    private Task CancelAsync() => Reference.CancelAsync();

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(UIStrings), ErrorMessageResourceName = nameof(UIStrings.Cd_NameRequired))]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Range(0.01, 9999)]
        public double Quantity { get; set; } = 1;

        [Required]
        public string Unit { get; set; } = "pcs";

        [Required]
        public string Location { get; set; } = "pantry";

        [Required(ErrorMessageResourceType = typeof(UIStrings), ErrorMessageResourceName = nameof(UIStrings.Cd_ExpiryRequired))]
        public DateTime? ExpirationDate { get; set; } = DateTime.Today.AddDays(7);

        [StringLength(500)]
        public string? Notes { get; set; }
    }
}
