@namespace Client.Components
@using BlazorBlueprint.Primitives.SwipeArea
@inject BottomSheetService Sheet
@inject ServerApi Api
@inject ToastService Toasts
@inject ILogger<PantryItemRow> Logger
@inject LocalizationService Loc

<BbSwipeArea Axis="SwipeAxis.Horizontal" TouchAction="SwipeTouchAction.PanY" OnSwipe="HandleSwipe"
             OnSwipeMove="HandleMove" OnSwipeCancel="HandleCancel">
    <div class="relative overflow-hidden rounded-md border bg-card">
        <div class="absolute inset-y-0 right-0 flex items-stretch">
            <button type="button" @onclick="EditAsync"
                    class="flex w-[60px] flex-col items-center justify-center gap-1 bg-secondary text-secondary-foreground">
                <LucideIcon Name="pencil" Size="18" />
                <span class="text-xs">@Loc["Edit"]</span>
            </button>
            <button type="button" @onclick="CompleteAsync"
                    class="flex w-[60px] flex-col items-center justify-center gap-1 bg-primary text-primary-foreground">
                <LucideIcon Name="check" Size="18" />
                <span class="text-xs">@Loc["MarkAsUsed"]</span>
            </button>
            <button type="button" @onclick="DeleteAsync"
                    class="flex w-[60px] flex-col items-center justify-center gap-1 bg-destructive text-destructive-foreground">
                <LucideIcon Name="trash-2" Size="18" />
                <span class="text-xs">@Loc["Delete"]</span>
            </button>
        </div>
        <button type="button" @onclick="TapAsync"
                class="relative block w-full bg-background p-3 text-left"
                style="transform: translateX(@_offsetPx); transition: @(_dragging ? "none" : "transform 150ms");">
            @{
                var status = ExpiryHelper.GetStatus(Item.ExpirationDate, Today);
            }
            <span class="flex items-center justify-between gap-2">
                <span class="font-medium line-clamp-1">@Item.Name</span>
                <BbBadge Variant="@ExpiryHelper.Badge(status)" class="shrink-0">@ExpiryHelper.Label(status, Loc)</BbBadge>
            </span>
            <span class="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
                <span>@Item.Quantity @Item.Unit</span>
                <BbBadge Variant="BadgeVariant.Outline" class="shrink-0">@Item.Location</BbBadge>
                <span class="shrink-0">@Item.ExpirationDate.ToString("MMM d")</span>
            </span>
        </button>
    </div>
</BbSwipeArea>

@code
{
    private const double ActionsWidth = 180;

    [Parameter, EditorRequired]
    public PantryItemDto Item { get; set; } = default!;

    [Parameter]
    public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Tap on the row body (open details).</summary>
    [Parameter]
    public EventCallback<PantryItemDto> OnOpen { get; set; }

    /// <summary>Raised after an action changed the item (reload the list).</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private double _offset;
    private bool _dragging;
    private bool _open;

    private string _offsetPx => _offset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private void HandleMove(SwipeMoveEventArgs e)
    {
        _dragging = true;
        _offset = Math.Clamp(e.DeltaX, -ActionsWidth, 0);
    }

    private void HandleSwipe(SwipeEventArgs e)
    {
        _dragging = false;

        if (e.Direction == SwipeDirection.Left)
        {
            _open = true;
            _offset = -ActionsWidth;
        }
        else
        {
            _open = false;
            _offset = 0;
        }
    }

    private void HandleCancel()
    {
        _dragging = false;
        _offset = _open ? -ActionsWidth : 0;
    }

    private void ResetSwipe()
    {
        _open = false;
        _offset = 0;
    }

    private async Task TapAsync()
    {
        if (_open)
        {
            ResetSwipe();
            return;
        }

        await OnOpen.InvokeAsync(Item);
    }

    private async Task EditAsync()
    {
        ResetSwipe();
        var result = await Sheet.OpenAsync<ItemForm>(
            new Dictionary<string, object?> { ["Item"] = Item });

        if (!result.Cancelled)
            await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        ResetSwipe();
        await RemoveAsync(Loc["ItemDeleted"], Loc["CouldNotDelete"]);
    }

    private async Task CompleteAsync()
    {
        ResetSwipe();
        await RemoveAsync(Loc["ItemMarkedAsUsed", Item.Name], Loc["CouldNotMarkAsUsed"]);
    }

    /// <summary>
    /// Completed items are deleted outright (v1.4.1 semantics): no consumed
    /// state exists server-side, so both delete and complete remove the row.
    /// </summary>
    private async Task RemoveAsync(string successMessage, string errorMessage)
    {
        try
        {
            using var response = await Api.Pantry.DeleteAsync(Item.Id);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogWarning("Item {ItemId} delete failed with {StatusCode}", Item.Id, response.StatusCode);
                Toasts.Error(errorMessage);
                return;
            }

            Toasts.Success(successMessage);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Item {ItemId} delete failed", Item.Id);
            Toasts.Error(errorMessage);
        }
    }
}
