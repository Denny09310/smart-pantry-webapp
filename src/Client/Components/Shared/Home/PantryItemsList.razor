@namespace Client.Components.Shared.Home
@inject IStringLocalizer<UIStrings> L

<BbCard>
    <BbCardContent Class="p-0">
        <InfiniteScrollList T="PantryItemDto" Items="@Items" KeySelector="@(i => i.Id)" EnsureVisibleId="@HighlightId">
            <ItemTemplate Context="item">
                <div id="@($"pantry-item-{item.Id}")" class="flex items-center gap-3 border-b p-3 last:border-0 @(item.Id == HighlightId ? "bg-muted" : "")">
                    <BbAvatar>
                        <BbAvatarFallback>@item.GetInitials()</BbAvatarFallback>
                    </BbAvatar>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="truncate text-sm font-semibold">@item.Name</p>
                            <BbBadge Variant="@item.GetBadgeVariant()" Class="shrink-0">@item.GetLabel(L)</BbBadge>
                        </div>
                        <p class="truncate text-xs text-muted-foreground">@item.FormatQuantity() •
                            @item.GetDisplayLocation()@if (item.CreatedByName is not null) { <text>@L["Pil_AddedBy", item.CreatedByName]</text> }</p>
                            <div class="mt-1 flex items-center justify-between gap-2">
                                <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideIcon Name="calendar-days" Size="12" />
                                    @item.FormatExpiration(L)
                                </span>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                          AriaLabel="@L["Common_DeleteAria", item.Name]" Loading="@IsBusy(item)"
                                          OnClick="@(() => OnDelete.InvokeAsync(item))">
                                    <LucideIcon Name="trash-2" Size="16" />
                                </BbButton>
                            </div>
                        </div>
                    </div>
            </ItemTemplate>
        </InfiniteScrollList>
    </BbCardContent>
</BbCard>

@code
{
    [Parameter]
    public IReadOnlyList<PantryItemDto> Items { get; set; } = [];

    [Parameter]
    public EventCallback<PantryItemDto> OnDelete { get; set; }

    [Parameter]
    public IReadOnlyCollection<string> DeletingIds { get; set; } = [];

    [Parameter]
    public string? HighlightId { get; set; }

    private bool IsBusy(PantryItemDto item) => DeletingIds.Contains(item.Id);
}
