@namespace Client.Components.Shared.Home
@inject ServerApi Api
@inject LanguageService Languages
@inject IStringLocalizer<UIStrings> L
@inject ILogger<RecipeSuggestions> Log

@if (_items is not null && _items.Count > 0)
{
    <section aria-label="@L["Recipe_Title"]" class="space-y-3">
        <div>
            <h2 class="text-base font-semibold">@L["Recipe_Title"]</h2>
            <p class="text-sm text-muted-foreground">@L["Recipe_Description"]</p>
        </div>
        <div class="space-y-2">
            @foreach (var recipe in _items)
            {
                <BbCard @key="@recipe.IdMeal">
                    <BbCardContent Class="flex items-center gap-3 p-3">
                        <img src="@recipe.ThumbnailUrl" alt="" loading="lazy"
                             class="h-16 w-16 shrink-0 rounded-lg object-cover" />
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@recipe.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @L["Recipe_Uses", string.Join(", ", recipe.MatchedIngredients)]
                            </p>
                            <a href="@recipe.SourceUrl" target="_blank" rel="noopener"
                               aria-label="@L["Recipe_OpenAria"]"
                               class="text-xs text-primary underline">@recipe.SourceUrl</a>
                        </div>
                    </BbCardContent>
                </BbCard>
            }
        </div>
        <p class="text-xs text-muted-foreground">@L["Recipe_Attribution"]</p>
    </section>
}

@code {
    private List<RecipeSuggestionDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var response = await Api.Recipes.GetSuggestionsAsync(Languages.Current);

            if (response.IsSuccessfulWithContent)
                _items = new(response.Content.Items);
        }
        catch (Exception ex)
        {
            // Suggestions are inspiration, never load-bearing: hide on failure.
            Log.LogWarning(ex, "Recipe suggestions load failed.");
            _items = null;
        }
    }
}
