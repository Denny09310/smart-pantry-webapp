@namespace Client.Components
@using Client.Models
@inject BottomSheetService Sheet
@inject LocalizationService Loc

<div class="flex h-full flex-col">
    <h2 class="flex-none text-lg font-semibold">@Loc["Filters"]</h2>

    <div class="sheet-scroll space-y-5">
        <div>
            <span class="mb-1 block text-sm font-medium">@Loc["Category"]</span>
            <BbChipSet @bind-Value="_state.Category" Class="scrollbar-none!" Wrap="false">
                <BbChip Value="@(CosmeticCategories.All)">@Loc["AllCategories"]</BbChip>
                @foreach (var category in CosmeticCategories.Values)
                {
                    <BbChip Value="@(category)">@CategoryLabel(category)</BbChip>
                }
            </BbChipSet>
        </div>

        <div>
            <span class="mb-1 block text-sm font-medium">@Loc["Status"]</span>
            <BbChipSet @bind-Value="_state.Status" Class="scrollbar-none!" Wrap="false">
                <BbChip Value="@CosmeticRules.StatusAll">@Loc["AllStatuses"]</BbChip>
                <BbChip Value="@CosmeticRules.StatusExpired">@Loc["StatusExpired"]</BbChip>
                <BbChip Value="@CosmeticRules.StatusSoon">@Loc["StatusExpiringSoon"]</BbChip>
                <BbChip Value="@CosmeticRules.StatusGood">@Loc["StatusGood"]</BbChip>
            </BbChipSet>
        </div>

        <div>
            <span class="mb-1 block text-sm font-medium">@Loc["SortBy"]</span>
            <BbSelect TValue="ItemSort" @bind-Value="_state.Sort" AriaLabel="@Loc["SortBy"]"
                      DisplayTextSelector="SortDisplayText">
                <BbSelectTrigger>
                    <BbSelectValue />
                </BbSelectTrigger>
                <BbSelectContent>
                    <BbSelectItem Value="@ItemSort.ExpiryAsc" Text="@Loc["SortExpiryAsc"]" />
                    <BbSelectItem Value="@ItemSort.ExpiryDesc" Text="@Loc["SortExpiryDesc"]" />
                    <BbSelectItem Value="@ItemSort.Name" Text="@Loc["SortByNameAZ"]" />
                </BbSelectContent>
            </BbSelect>
        </div>
    </div>

    <div class="grid flex-none grid-cols-2 gap-2 border-t pt-3">
        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" @onclick="Reset">@Loc["Reset"]</BbButton>
        <BbButton Type="ButtonType.Button" @onclick="ApplyAsync">@Loc["ApplyFilters"]</BbButton>
    </div>
</div>

@code
{
    public sealed record SelectedFilters(string? Category, string Status, ItemSort Sort);

    [Parameter] public string? Category { get; set; }
    [Parameter] public string Status { get; set; } = CosmeticRules.StatusAll;
    [Parameter] public ItemSort Sort { get; set; } = ItemSort.ExpiryAsc;

    protected override void OnParametersSet()
    {
        if (_state.SeenSort is null || Category != _state.SeenCategory || Status != _state.SeenStatus || Sort != _state.SeenSort)
        {
            _state.SeenCategory = Category;
            _state.SeenStatus = Status;
            _state.SeenSort = Sort;

            _state.Category = Category;
            _state.Status = Status;
            _state.Sort = Sort;
        }
    }

    private void Reset()
    {
        _state.Category = CosmeticCategories.All;
        _state.Status = CosmeticRules.StatusAll;
        _state.Sort = ItemSort.ExpiryAsc;
    }

    private string SortDisplayText(ItemSort sort) => sort switch
    {
        ItemSort.ExpiryDesc => Loc["SortExpiryDesc"],
        ItemSort.Name => Loc["SortByNameAZ"],
        _ => Loc["SortExpiryAsc"]
    };

    private Task ApplyAsync()
        => Sheet.CloseAsync(new SelectedFilters(_state.Category, _state.Status, _state.Sort));

    private string CategoryLabel(string category) => category switch
    {
        "hair" => Loc["Hair"],
        "body" => Loc["Body"],
        "hands" => Loc["Hands"],
        "perfume" => Loc["Perfume"],
        _ => Loc["Face"]
    };
}
