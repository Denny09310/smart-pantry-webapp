@namespace Client.Components
@using Client.Models
@inject BottomSheetService Sheet
@inject LocalizationService Loc

<div class="flex h-full flex-col">
    <h2 class="flex-none text-lg font-semibold">@Loc["Filters"]</h2>

    <div class="min-h-0 flex-1 touch-pan-y space-y-5 overflow-y-auto overscroll-contain py-1 pr-1">
        <div>
            <span class="mb-1 block text-sm font-medium">@Loc["Location"]</span>
            <BbChipSet @bind-Value="_state.Location" Class="scrollbar-none!" Wrap="false">
                <BbChip Value="@(PantryLocations.All)">@Loc["AllLocations"]</BbChip>
                @foreach (var location in PantryLocations.Values)
                {
                    <BbChip Value="@(location)">@LocationLabel(location)</BbChip>
                }
            </BbChipSet>
        </div>

        <div>
            <span class="mb-1 block text-sm font-medium">@Loc["Status"]</span>
            <BbChipSet @bind-Value="_state.Status" Class="scrollbar-none!" Wrap="false">
                <BbChip Value="@PantryRules.StatusAll">@Loc["AllStatuses"]</BbChip>
                <BbChip Value="@PantryRules.StatusExpired">@Loc["StatusExpired"]</BbChip>
                <BbChip Value="@PantryRules.StatusSoon">@Loc["StatusExpiringSoon"]</BbChip>
                <BbChip Value="@PantryRules.StatusFresh">@Loc["StatusFresh"]</BbChip>
            </BbChipSet>
        </div>

        <div>
            <span class="mb-1 block text-sm font-medium">@Loc["SortBy"]</span>
            <BbSelect TValue="ItemSort" @bind-Value="_state.Sort" AriaLabel="@Loc["SortBy"]"
                      DisplayTextSelector="SortDisplayText">
                <BbSelectTrigger>
                    <BbSelectValue />
                </BbSelectTrigger>
                <BbSelectContent>
                    <BbSelectItem Value="@ItemSort.ExpiryAsc" Text="@Loc["SortExpiryAsc"]" />
                    <BbSelectItem Value="@ItemSort.ExpiryDesc" Text="@Loc["SortExpiryDesc"]" />
                    <BbSelectItem Value="@ItemSort.Name" Text="@Loc["SortByNameAZ"]" />
                </BbSelectContent>
            </BbSelect>
        </div>
    </div>

    <div class="grid flex-none grid-cols-2 gap-2 border-t pt-3">
        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" @onclick="Reset">@Loc["Reset"]</BbButton>
        <BbButton Type="ButtonType.Button" @onclick="ApplyAsync">@Loc["ApplyFilters"]</BbButton>
    </div>
</div>

@code
{
    public sealed record SelectedFilters(string? Location, string Status, ItemSort Sort);

    [Parameter] public string? Location { get; set; }
    [Parameter] public string Status { get; set; } = PantryRules.StatusAll;
    [Parameter] public ItemSort Sort { get; set; } = ItemSort.ExpiryAsc;

    protected override void OnParametersSet()
    {
        if (_state.SeenSort is null || Location != _state.SeenLocation || Status != _state.SeenStatus || Sort != _state.SeenSort)
        {
            _state.SeenLocation = Location;
            _state.SeenStatus = Status;
            _state.SeenSort = Sort;

            _state.Location = Location;
            _state.Status = Status;
            _state.Sort = Sort;
        }
    }

    private void Reset()
    {
        _state.Location = PantryLocations.All;
        _state.Status = PantryRules.StatusAll;
        _state.Sort = ItemSort.ExpiryAsc;
    }

    private string SortDisplayText(ItemSort sort) => sort switch
    {
        ItemSort.ExpiryDesc => Loc["SortExpiryDesc"],
        ItemSort.Name => Loc["SortByNameAZ"],
        _ => Loc["SortExpiryAsc"]
    };

    private Task ApplyAsync()
        => Sheet.CloseAsync(new SelectedFilters(_state.Location, _state.Status, _state.Sort));

    private string LocationLabel(string location) => location switch
    {
        "fridge" => Loc["Fridge"],
        "freezer" => Loc["Freezer"],
        "cabinet" => Loc["Cabinet"],
        _ => Loc["Pantry"]
    };
}
