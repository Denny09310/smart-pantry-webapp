@namespace Client.Components
@using Client.Models
@inject BottomSheetService Sheet

<div class="flex h-full flex-col">
    <h2 class="flex-none text-lg font-semibold">Filters</h2>

    <div class="min-h-0 flex-1 touch-pan-y space-y-5 overflow-y-auto overscroll-contain py-1 pr-1">
        <div>
            <span class="mb-1 block text-sm font-medium">Location</span>
            <BbChipSet @bind-Value="_state.Location" Class="scrollbar-none!" Wrap="false">
                <BbChip Value="@(PantryLocations.All)">All locations</BbChip>
                @foreach (var location in PantryLocations.Values)
                {
                    <BbChip Value="@(location)">@location</BbChip>
                }
            </BbChipSet>
        </div>

        <div>
            <span class="mb-1 block text-sm font-medium">Status</span>
            <BbChipSet @bind-Value="_state.Status" Class="scrollbar-none!" Wrap="false">
                <BbChip Value="@PantryRules.StatusAll">All statuses</BbChip>
                <BbChip Value="@PantryRules.StatusExpired">Expired</BbChip>
                <BbChip Value="@PantryRules.StatusSoon">Expiring soon</BbChip>
                <BbChip Value="@PantryRules.StatusFresh">Fresh</BbChip>
            </BbChipSet>
        </div>

        <div>
            <span class="mb-1 block text-sm font-medium">Sort by</span>
            <BbNativeSelect TValue="ItemSort" @bind-Value="_state.Sort" AriaLabel="Sort items">
                <option value="@ItemSort.ExpiryAsc">Expiring first</option>
                <option value="@ItemSort.ExpiryDesc">Expiring last</option>
                <option value="@ItemSort.Name">Name A–Z</option>
            </BbNativeSelect>
        </div>
    </div>

    <div class="grid flex-none grid-cols-2 gap-2 border-t pt-3">
        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" @onclick="Reset">Reset</BbButton>
        <BbButton Type="ButtonType.Button" @onclick="ApplyAsync">Apply filters</BbButton>
    </div>
</div>

@code
{
    public sealed record SelectedFilters(string? Location, string Status, ItemSort Sort);

    [Parameter] public string? Location { get; set; }
    [Parameter] public string Status { get; set; } = PantryRules.StatusAll;
    [Parameter] public ItemSort Sort { get; set; } = ItemSort.ExpiryAsc;

    protected override void OnParametersSet()
    {
        if (_state.SeenSort is null || Location != _state.SeenLocation || Status != _state.SeenStatus || Sort != _state.SeenSort)
        {
            _state.SeenLocation = Location;
            _state.SeenStatus = Status;
            _state.SeenSort = Sort;

            _state.Location = Location;
            _state.Status = Status;
            _state.Sort = Sort;
        }
    }

    private void Reset()
    {
        _state.Location = PantryLocations.All;
        _state.Status = PantryRules.StatusAll;
        _state.Sort = ItemSort.ExpiryAsc;
    }

    private Task ApplyAsync()
        => Sheet.CloseAsync(new SelectedFilters(_state.Location, _state.Status, _state.Sort));
}
