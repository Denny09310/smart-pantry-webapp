@namespace Client.Components
@typeparam TItem
@using Bit.Butil
@inject IJSRuntime JS
@inject LocalizationService Loc
@implements IAsyncDisposable

@if (_state.Error is not null)
{
    <div role="alert" class="space-y-2 rounded-md border p-4 text-center">
        <p class="text-sm">@Loc["LoadMoreFailed"]</p>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="LoadNextAsync">@Loc["Retry"]</BbButton>
    </div>
}

@foreach (var item in _state.Items)
{
    <div @key="@(KeySelector?.Invoke(item) ?? item)">
        @ItemTemplate(item)
    </div>
}

@if (_state.Loading)
{
    @if (LoadingTemplate is not null)
    {
        @LoadingTemplate
    }
    else
    {
        <p class="py-2 text-center text-sm text-muted-foreground">@Loc["LoadingState"]</p>
    }
}
else if (_state.Error is null && _state.Items.Count == 0)
{
    @EmptyTemplate
}

<div @ref="_state.Sentinel" class="h-px" aria-hidden="true"></div>

@code
{
    /// <summary>Loads one page: (skip, take, cancellation) to items + total.</summary>
    [Parameter, EditorRequired]
    public Func<int, int, CancellationToken, Task<Page<TItem>>> LoadPageAsync { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment EmptyTemplate { get; set; } = default!;

    [Parameter]
    public RenderFragment? LoadingTemplate { get; set; }

    [Parameter]
    public Func<TItem, object?>? KeySelector { get; set; }

    [Parameter]
    public EventCallback<int> TotalChanged { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 20;

    protected override async Task OnInitializedAsync()
    {
        _state.Cts = new CancellationTokenSource();
        await LoadNextAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _state.Subscription = await _state.Sentinel.ObserveIntersection(JS, OnIntersection, new IntersectionObserverOptions
        {
            RootMargin = "0px 0px 200px 0px",
            MinInterval = TimeSpan.FromMilliseconds(150)
        });
    }

    /// <summary>Clears the list and loads the first page (call after filter changes).</summary>
    public async Task ReloadAsync()
    {
        _state.Generation++;
        _state.Items.Clear();
        _state.Total = int.MaxValue;
        _state.Error = null;
        StateHasChanged();

        // A load already running would discard its result on the generation
        // check and leave the list empty: let it finish, then load fresh.
        if (_state.LoadTask is { IsCompleted: false } running)
        {
            try
            {
                await running;
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception)
            {
            }
        }

        if (!_state.Disposed)
            await LoadNextAsync();
    }

    /// <summary>
    /// Drops the row with the given key without refetching. The query total
    /// only shrinks when a loaded row actually disappears; a later page load
    /// re-syncs it from the server either way.
    /// </summary>
    public async Task<bool> RemoveByKeyAsync(object? key)
    {
        var index = FindIndex(key);
        if (index < 0)
            return false;

        _state.Items.RemoveAt(index);
        _state.Total = Math.Max(0, _state.Total - 1);
        await TotalChanged.InvokeAsync(_state.Total);
        StateHasChanged();
        return true;
    }

    /// <summary>Replaces the loaded row with the same key, if present.</summary>
    public Task<bool> ReplaceAsync(TItem item)
    {
        var index = FindIndex(KeySelector?.Invoke(item));
        if (index < 0)
            return Task.FromResult(false);

        _state.Items[index] = item;
        StateHasChanged();
        return Task.FromResult(true);
    }

    /// <summary>
    /// Inserts one item at its sorted position and bumps the total. Only call
    /// when <see cref="IsFullyLoaded"/> — otherwise the position is a guess
    /// and the caller should <see cref="ReloadAsync"/> instead.
    /// </summary>
    public async Task InsertSortedAsync(TItem item, Comparison<TItem> comparison)
    {
        var index = _state.Items.FindIndex(x => comparison(item, x) < 0);
        if (index < 0)
            _state.Items.Add(item);
        else
            _state.Items.Insert(index, item);

        _state.Total++;
        await TotalChanged.InvokeAsync(_state.Total);
        StateHasChanged();
    }

    /// <summary>True when every row is loaded with no error or pending load.</summary>
    public bool IsFullyLoaded => !_state.HasMore && !_state.Loading && _state.Error is null;

    private int FindIndex(object? key)
    {
        if (KeySelector is null || key is null)
            return -1;

        for (var i = 0; i < _state.Items.Count; i++)
        {
            if (Equals(KeySelector(_state.Items[i]), key))
                return i;
        }

        return -1;
    }

    private Task LoadNextAsync()
    {
        if (_state.Loading || !_state.HasMore || _state.Disposed)
            return Task.CompletedTask;

        _state.LoadTask = LoadNextCoreAsync();
        return _state.LoadTask;
    }

    private async Task LoadNextCoreAsync()
    {
        if (_state.Loading || !_state.HasMore || _state.Disposed)
            return;

        _state.Loading = true;
        _state.Error = null;
        StateHasChanged();

        var generation = _state.Generation;

        try
        {
            var page = await LoadPageAsync(_state.Items.Count, PageSize, _state.Cts?.Token ?? CancellationToken.None);

            if (generation != _state.Generation || _state.Disposed)
                return;

            // A granular patch may have inserted rows while this page was in
            // flight: skip anything already loaded instead of duplicating it.
            if (KeySelector is not null)
            {
                var known = new HashSet<object?>();
                foreach (var existing in _state.Items)
                    known.Add(KeySelector(existing));

                foreach (var item in page.Items)
                {
                    if (known.Add(KeySelector(item)))
                        _state.Items.Add(item);
                }
            }
            else
            {
                _state.Items.AddRange(page.Items);
            }

            _state.Total = page.Total;
            await TotalChanged.InvokeAsync(_state.Total);
        }
        catch (OperationCanceledException) when (_state.Cts?.IsCancellationRequested == true)
        {
            // Self-cancellation on dispose; nothing to show.
        }
        catch (Exception)
        {
            _state.Error = "load";
        }
        finally
        {
            _state.Loading = false;
            if (!_state.Disposed)
                StateHasChanged();
        }
    }

    private async void OnIntersection(IntersectionObserverEntry[] entries)
    {
        try
        {
            if (entries.Length == 0 || !entries[^1].IsIntersecting)
                return;

            await InvokeAsync(LoadNextAsync);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _state.Disposed = true;

        if (_state.Cts is not null)
        {
            await _state.Cts.CancelAsync();
            _state.Cts.Dispose();
        }

        if (_state.Subscription is not null)
        {
            try
            {
                await _state.Subscription.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
