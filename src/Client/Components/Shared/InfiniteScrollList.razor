@namespace Client.Components.Shared
@using Bit.Butil
@typeparam T
@inject IJSRuntime JS
@inject IStringLocalizer<UIStrings> L
@implements IAsyncDisposable

@foreach (var item in _visible)
{
    @ItemTemplate(item)
}

@if (_hasMore)
{
    <div @ref="_sentinel" class="flex flex-col items-center gap-2 py-4">
        @if (_observerFailed)
        {
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LoadNextAsync">
                @(TriggerButtonText ?? L["Is_ShowMore"])
            </BbButton>
        }
        else
        {
            <BbSpinner Size="SpinnerSize.Default" />
        }
    </div>
}

@code
{
    public readonly record struct PageResult(IReadOnlyList<T> Items, int Total);

    [Parameter]
    public IReadOnlyList<T> Items { get; set; } = [];

    [Parameter]
    public Func<int, int, CancellationToken, Task<PageResult>>? ItemsProvider { get; set; }

    [Parameter]
    public string? ResetKey { get; set; }

    [Parameter]
    public EventCallback<int> TotalChanged { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<T> ItemTemplate { get; set; } = default!;

    [Parameter]
    public int PageSize { get; set; } = 20;

    [Parameter]
    public string? TriggerButtonText { get; set; }

    private List<T> _visible = [];
    private int _total;
    private bool _hasMore;
    private bool _loading;
    private bool _initializing = true;
    private string? _renderedResetKey;
    private IReadOnlyList<T>? _renderedItems;
    private ElementReference _sentinel;
    private ButilSubscription? _observation;
    private bool _observerFailed;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnParametersSetAsync()
    {
        if (ItemsProvider is not null)
        {
            if (_renderedResetKey == ResetKey && !_initializing)
                return;

            _renderedResetKey = ResetKey;
            _initializing = false;
            await ResetAndLoadFirstPageAsync();
            return;
        }

        if (_renderedItems is not null && Items.SequenceEqual(_renderedItems))
            return;

        _renderedItems = Items;
        _total = Items.Count;
        _visible = Items.Take(PageSize).ToList();
        _hasMore = _visible.Count < _total;
        await TotalChanged.InvokeAsync(_total);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hasMore && _observation is null && !_observerFailed)
            await StartObservingAsync();
        else if (!_hasMore && _observation is not null)
            await StopObservingAsync();
    }

    private async Task ResetAndLoadFirstPageAsync()
    {
        await StopObservingAsync();
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();

        _visible = [];
        _total = 0;
        _hasMore = true;
        _observerFailed = false;
        StateHasChanged();

        await LoadNextAsync();
    }

    public Task RefreshAsync() => ResetAndLoadFirstPageAsync();

    private async Task StartObservingAsync()
    {
        try
        {
            _observation = await _sentinel.ObserveIntersection(
                JS,
                entries =>
                {
                    if (entries.Any(e => e.IsIntersecting))
                        _ = InvokeAsync(LoadNextAsync);
                },
                new IntersectionObserverOptions { RootMargin = "0px 0px 400px 0px" });
        }
        catch
        {
            _observerFailed = true;
            StateHasChanged();
        }
    }

    private async Task LoadNextAsync()
    {
        if (_loading)
            return;

        if (ItemsProvider is null)
        {
            if (_visible.Count >= _total)
                return;

            _visible = (_renderedItems?.Take(_visible.Count + PageSize) ?? _visible).ToList();
            _hasMore = _visible.Count < _total;
            StateHasChanged();
            return;
        }

        if (!_hasMore && _visible.Count > 0)
            return;

        _loading = true;
        StateHasChanged();

        try
        {
            var result = await ItemsProvider(_visible.Count, PageSize, _loadCts?.Token ?? CancellationToken.None);
            _visible.AddRange(result.Items);
            _total = result.Total;
            _hasMore = _visible.Count < _total;
            await TotalChanged.InvokeAsync(_total);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a filter reset; the new load owns the list now.
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task StopObservingAsync()
    {
        if (_observation is not null)
        {
            await _observation.DisposeAsync();
            _observation = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        await StopObservingAsync();
    }
}
