@namespace Client.Components.Shared
@using Bit.Butil
@typeparam T
@inject IJSRuntime JS
@inject IStringLocalizer<UIStrings> L
@implements IAsyncDisposable

@foreach (var item in _visible)
{
    @ItemTemplate(item)
}

@if (_hasMore)
{
    <div @ref="_sentinel" class="flex flex-col items-center gap-2 py-4">
        @if (_loading)
        {
            <BbSpinner Size="SpinnerSize.Default" />
        }
        else if (_observerFailed)
        {
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LoadNextAsync">
                @(TriggerButtonText ?? L["Is_ShowMore"])
            </BbButton>
        }
        else
        {
            <BbSpinner Size="SpinnerSize.Default" />
        }
    </div>
}

@code
{
    public readonly record struct PageResult(IReadOnlyList<T> Items, int Total);

    [Parameter]
    public IReadOnlyList<T> Items { get; set; } = [];

    [Parameter]
    public Func<int, int, Task<PageResult>>? ItemsProvider { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<T> ItemTemplate { get; set; } = default!;

    [Parameter]
    public int PageSize { get; set; } = 20;

    [Parameter]
    public string? TriggerButtonText { get; set; }

    private List<T> _visible = [];
    private int _total;
    private IReadOnlyList<T>? _renderedItems;
    private ElementReference _sentinel;
    private ButilSubscription? _observation;
    private bool _observerFailed;
    private bool _restartObservation;
    private bool _loading;
    private bool _hasMore;
    private int _loadedCount;

    protected override void OnParametersSet()
    {
        if (ItemsProvider is not null)
        {
            if (_renderedItems is not null && Items.SequenceEqual(_renderedItems) && _loadedCount == Items.Count)
                return;

            _renderedItems = Items;
            _loadedCount = Items.Count;
            _visible = Items.Take(_loadedCount).ToList();
            _total = _visible.Count;
            _restartObservation = true;
            _hasMore = false;
            return;
        }

        if (_renderedItems is not null && Items.SequenceEqual(_renderedItems))
            return;

        _renderedItems = Items;
        _total = Items.Count;
        _visible = Items.Take(Math.Max(_loadedCount == 0 ? PageSize : _loadedCount, PageSize)).ToList();
        _loadedCount = _visible.Count;
        _restartObservation = true;
        _hasMore = _loadedCount < _total;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restartObservation)
        {
            _restartObservation = false;
            await StopObservingAsync();
        }

        if (_hasMore && _observation is null && !_observerFailed)
            await StartObservingAsync();
        else if (!_hasMore && _observation is not null)
            await StopObservingAsync();
    }

    private async Task StartObservingAsync()
    {
        try
        {
            _observation = await _sentinel.ObserveIntersection(
                JS,
                entries =>
                {
                    if (entries.Any(e => e.IsIntersecting))
                        _ = InvokeAsync(LoadNextAsync);
                },
                new IntersectionObserverOptions { RootMargin = "0px 0px 400px 0px" });
        }
        catch
        {
            _observerFailed = true;
            StateHasChanged();
        }
    }

    private async Task LoadNextAsync()
    {
        if (_loading)
            return;

        if (ItemsProvider is not null)
        {
            if (_visible.Count >= _total && _total >= 0)
                return;

            _loading = true;
            StateHasChanged();

            try
            {
                var skip = _visible.Count;
                var result = await ItemsProvider(skip, PageSize);
                if (skip == 0)
                {
                    _visible = result.Items.ToList();
                }
                else
                {
                    _visible.AddRange(result.Items);
                }
                _total = result.Total;
                _hasMore = _visible.Count < _total;
                _loadedCount = _visible.Count;
            }
            finally
            {
                _loading = false;
                StateHasChanged();
            }
            return;
        }

        if (_visible.Count >= _total)
            return;

        _visible = (_renderedItems?.Take(_visible.Count + PageSize) ?? _visible).ToList();
        _loadedCount = _visible.Count;
        _hasMore = _loadedCount < _total;
        StateHasChanged();
    }

    private async Task StopObservingAsync()
    {
        if (_observation is not null)
        {
            await _observation.DisposeAsync();
            _observation = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopObservingAsync();
    }
}