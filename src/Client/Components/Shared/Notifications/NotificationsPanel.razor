@namespace Client.Components
@inject ServerApi Api
@inject NotificationService Notifications
@inject BottomSheetService Sheet
@inject ILogger<NotificationsPanel> Logger
@implements IDisposable

<div class="flex h-full flex-col">
    <div class="flex flex-none items-center justify-between gap-2">
        <h2 class="text-lg font-semibold">Notifications</h2>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Button"
                  Disabled="@(_unreadCount == 0)" @onclick="MarkAllReadAsync">
            Mark all read
        </BbButton>
    </div>

    <div class="min-h-0 flex-1 touch-pan-y overflow-y-auto overscroll-contain py-1 pr-1">
    <InfiniteScrollList TItem="NotificationDto" @ref="_list" LoadPageAsync="LoadPageAsync"
                        KeySelector="@(x => x.Id)" PageSize="20">
        <ItemTemplate>
            <div class="mb-2">
                <NotificationRow Item="context" OnView="ViewItemAsync" OnMarkRead="MarkReadAsync" />
            </div>
        </ItemTemplate>
        <LoadingTemplate>
            <div class="space-y-2" aria-hidden="true">
                <BbSkeleton Height="64px" Class="w-full" />
                <BbSkeleton Height="64px" Class="w-full" />
            </div>
        </LoadingTemplate>
        <EmptyTemplate>
            <BbEmpty Title="All caught up" Description="New expiry reminders will appear here">
                <Icon>
                    <LucideIcon Name="bell" Size="24" />
                </Icon>
            </BbEmpty>
        </EmptyTemplate>
    </InfiniteScrollList>
    </div>
</div>

@code
{
    private InfiniteScrollList<NotificationDto>? _list;
    private int _unreadCount;

    protected override void OnInitialized()
    {
        Notifications.Changed += OnChanged;
        _unreadCount = Notifications.UnreadCount;
    }

    public void Dispose() => Notifications.Changed -= OnChanged;

    private async void OnChanged()
    {
        try
        {
            _unreadCount = Notifications.UnreadCount;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task<Page<NotificationDto>> LoadPageAsync(int skip, int take, CancellationToken ct)
    {
        using var response = await Api.Notifications.GetAsync(
            new GetNotificationsRequest { Skip = skip, Take = take }, ct);

        if (!response.IsSuccessfulWithContent)
        {
            Logger.LogWarning("Notifications load failed with {StatusCode}", response.StatusCode);
            throw new HttpRequestException($"Notifications load failed with {response.StatusCode}.");
        }

        _unreadCount = response.Content.UnreadCount;
        return new Page<NotificationDto>(response.Content.Items.ToList(), response.Content.TotalCount);
    }

    private async Task ViewItemAsync(NotificationDto notification)
    {
        await Notifications.MarkReadAsync(notification.Id);
        await Sheet.OpenAsync<ItemDetailsBody>(new Dictionary<string, object?> { ["ItemId"] = notification.PantryItemId });
    }

    private async Task MarkReadAsync(NotificationDto notification)
    {
        if (await Notifications.MarkReadAsync(notification.Id) && _list is not null)
            await _list.ReloadAsync();
    }

    private async Task MarkAllReadAsync()
    {
        await Notifications.MarkAllReadAsync();
        if (_list is not null)
            await _list.ReloadAsync();
    }
}
