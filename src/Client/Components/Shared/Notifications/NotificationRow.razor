@namespace Client.Components
@inject LocalizationService Loc

<SwipeableRow ActionsWidth="120" InnerClass="flex items-center gap-3" AriaLabel="@Item.ItemName"
              OnTap="@(() => OnView.InvokeAsync(Item))">
    <Actions>
        <SwipeActionButton Icon="eye" Label="@Loc["View"]"
                           Variant="SwipeActionVariant.Secondary"
                           OnClick="@(() => OnView.InvokeAsync(Item))" />
        @if (Item.ReadAt is null)
        {
            <SwipeActionButton Icon="check" Label="@Loc["MarkRead"]"
                               Variant="SwipeActionVariant.Primary"
                               OnClick="@(() => OnMarkRead.InvokeAsync(Item))" />
        }
    </Actions>
    <ChildContent>
        @if (Item.ReadAt is null)
        {
            <span class="h-2 w-2 flex-none rounded-full bg-primary"></span>
        }
        <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium">@Item.ItemName</span>
            <span class="block text-xs text-muted-foreground">
                @Loc["ExpiresAt", Item.ExpirationDate.ToString("MMM d")] · @Ago(Item.CreatedAt)
            </span>
        </span>
    </ChildContent>
</SwipeableRow>

@code
{
    [Parameter, EditorRequired]
    public NotificationDto Item { get; set; } = default!;

    [Parameter]
    public EventCallback<NotificationDto> OnView { get; set; }

    [Parameter]
    public EventCallback<NotificationDto> OnMarkRead { get; set; }

    private string Ago(DateTimeOffset created)
    {
        var age = DateTimeOffset.UtcNow - created;

        if (age.TotalMinutes < 1)
            return Loc["JustNow"];
        if (age.TotalHours < 1)
            return Loc["MinutesAgo", (int)age.TotalMinutes];
        if (age.TotalDays < 1)
            return Loc["HoursAgo", (int)age.TotalHours];
        if (age.TotalDays < 7)
            return Loc["DaysAgo", (int)age.TotalDays];

        return created.LocalDateTime.ToString("MMM d");
    }
}
