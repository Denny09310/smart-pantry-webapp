@namespace Client.Components
@inject BottomSheetService Sheet
@inject IJSRuntime JS
@inject ILogger<BottomSheetProvider> Logger
@inject LocalizationService Loc
@implements IAsyncDisposable

@if (_state.Body is not null)
{
    <div class="sheet-scrim" @onclick="OnScrimClick"></div>
    <section class="sheet-panel" role="dialog" aria-modal="true" aria-label="@Loc["BottomSheetLabel"]">
        <div class="sheet-inner sheet-pre bg-background border-t" @ref="_state.InnerRef">
            <div class="sheet-handle" data-sheet-drag @ref="_state.HandleRef">
                <span class="sheet-grip bg-gray-400 dark:bg-gray-600"></span>
            </div>
            <div class="sheet-body px-4 pb-4">
                <DynamicComponent Type="_state.Body.Type" Parameters="_state.Body.Parameters" />
            </div>
        </div>
    </section>
}

@code
{
    private sealed record VisibleBody(Type Type, Dictionary<string, object?> Parameters);

    protected override void OnInitialized()
    {
        Sheet.Changed += OnSheetChanged;
    }

    private async void OnSheetChanged()
    {
        try
        {
            if (Sheet.Current is { } entry)
            {
                _state.Body = new VisibleBody(entry.ComponentType, new Dictionary<string, object?>(entry.Parameters));
                _state.Options = entry.Options;
                _state.Closing = false;
                _state.PendingShow = true;
            }
            else
            {
                _state.PendingShow = false;
                _state.Closing = true;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_state.PendingShow && _state.Body is not null)
        {
            _state.PendingShow = false;
            await ShowAsync();
            StateHasChanged();
            return;
        }

        if (_state.Closing)
        {
            _state.Closing = false;

            if (_state.GestureClosed)
            {
                _state.GestureClosed = false;
                await TeardownAsync();
                _state.Body = null;
            }
            else
            {
                await (_state.Interop?.CloseAsync() ?? ValueTask.CompletedTask);
                await TeardownAsync();

                if (Sheet.Current is { } reopened)
                {
                    // Reopened while the close animation played.
                    _state.Body = new VisibleBody(reopened.ComponentType, new Dictionary<string, object?>(reopened.Parameters));
                    _state.Options = reopened.Options;
                    _state.PendingShow = true;
                }
                else
                {
                    _state.Body = null;
                }
            }

            StateHasChanged();
        }
    }

    private async Task ShowAsync()
    {
        try
        {
            _state.Interop ??= new BottomSheetInterop(JS);
            _state.Instance ??= DotNetObjectReference.Create(this);
            await _state.Interop.ShowAsync(_state.InnerRef, _state.HandleRef, _state.Instance, _state.Options.SnapPoints, _state.Options.InitialSnapIndex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bottom sheet failed to open");
            _state.PendingShow = false;
            _state.Body = null;
        }
    }

    private async Task TeardownAsync()
    {
        if (_state.Interop is not null)
        {
            await _state.Interop.DisposeAsync();
            _state.Interop = null;
        }

        _state.Instance?.Dispose();
        _state.Instance = null;
    }

    private Task OnScrimClick()
        => _state.Options.Dismissible && _state.Options.CloseOnScrimClick ? Sheet.CloseAsync() : Task.CompletedTask;

    [JSInvokable]
    public Task NotifyClosed()
    {
        if (!_state.Options.Dismissible)
            return Task.CompletedTask;

        _state.GestureClosed = true;
        return Sheet.CloseAsync();
    }

    [JSInvokable]
    public Task NotifyEscape()
        => _state.Options.Dismissible ? Sheet.CloseAsync() : Task.CompletedTask;

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Sheet.Changed -= OnSheetChanged;
        await TeardownAsync();
    }
}
