@namespace Client.Components
@using System.ComponentModel.DataAnnotations
@using Client.Models

@inject BottomSheetService Sheet
@inject MemberService Members
@inject ServerApi Api
@inject ToastService Toasts
@inject ILogger<ItemForm> Logger
@inject LocalizationService Loc

<div class="flex h-full flex-col">
    <div class="flex-none">
        <h2 class="text-lg font-semibold">@(Item is null ? Loc["AddItemTitle"] : Loc["EditItemTitle"])</h2>
        <p class="text-sm text-muted-foreground">
            @(Item is null ? Loc["AddItemSubtitle"] : Loc["EditItemSubtitle"])
        </p>
    </div>

    <EditForm Model="@_state.Input" OnValidSubmit="HandleSubmitAsync" class="flex min-h-0 flex-1 flex-col mt-4">
        <DataAnnotationsValidator />
        <CustomValidator @ref="_state.CustomValidator" />

        <div class="sheet-scroll space-y-4">
            @* Barcode Scanner *@
            <div class="space-y-2">
                <BarcodeScanner OnBarcodeScanned="OnBarcodeScannedAsync" AutoStart="false"
                                Searching="_state.LookingUp" />
                <p class="text-xs text-muted-foreground">@Loc["ScanBarcode"]</p>
            </div>

            @* Item name *@
            <BbField IsInvalid="@(!context.IsValid(() => _state.Input.Name))">
                <div class="flex items-center justify-between">
                    <BbFieldLabel For="item-name" Class="text-sm font-medium">@Loc["ItemName"] <span
                        class="text-xs text-muted-foreground">@Loc["Required"]</span></BbFieldLabel>
                    </div>
                    <BbFieldContent>
                        <BbInputGroup Class="bg-card">
                            <BbInputGroupInput Id="item-name" @bind-Value="_state.Input.Name"
                                               Placeholder="e.g. Face cream, Shampoo" UpdateTiming="UpdateTiming.Immediate" />
                        </BbInputGroup>
                        <BbFieldError Errors="@context.GetValidationMessages(() => _state.Input.Name)" />
                    </BbFieldContent>
                </BbField>

                @* Quantity & unit *@
                <div class="space-y-2">
                    <BbLabel Class="text-sm font-medium">@Loc["QuantityAndUnit"]</BbLabel>

                    <div class="flex items-center justify-between">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Type="ButtonType.Button"
                                  AriaLabel="@Loc["DecreaseQuantity"]" OnClick="DecrementQuantity">
                            <LucideIcon Name="minus" Size="16" />
                        </BbButton>
                        <div class="flex flex-col items-center leading-none">
                            <input type="number" @bind-value="_state.Input.Quantity" @bind-value:event="oninput"
                                   class="bg-transparent border-0 outline-none text-base font-semibold text-center w-16"
                                   min="0" max="9999" step="1" aria-label="@Loc["Quantity"]" />
                            <span class="text-xs text-muted-foreground">@_state.Input.Unit</span>
                        </div>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" Type="ButtonType.Button"
                                  AriaLabel="@Loc["IncreaseQuantity"]" OnClick="IncrementQuantity">
                            <LucideIcon Name="plus" Size="16" />
                        </BbButton>
                    </div>
                    <ValidationMessage For="@(() => _state.Input.Quantity)" class="text-sm text-destructive" />

                    <BbChipSet @bind-Value="_state.Input.Unit" Wrap="false" Class="gap-1.5 scrollbar-none!">
                        @foreach (var unit in CosmeticCategories.Units)
                        {
                            <BbChip Value="@(unit)">@unit</BbChip>
                        }
                    </BbChipSet>
                    <ValidationMessage For="@(() => _state.Input.Unit)" class="text-sm text-destructive" />
                </div>

                @* Category *@
                <div class="space-y-2">
                    <BbLabel Class="text-sm font-medium">@Loc["Category"]</BbLabel>
                    <BbToggleGroup @bind-Value="_state.Input.Category" Type="ToggleGroupType.Single" Required="true"
                                   Variant="ToggleVariant.Outline" Class="grid grid-cols-5 gap-2">
                        <BbToggleGroupItem Value="@("face")" Class="h-auto flex-col gap-1 py-2">
                            <LucideIcon Name="smile" Size="20" />
                            <span class="text-xs font-medium">@Loc["Face"]</span>
                        </BbToggleGroupItem>
                        <BbToggleGroupItem Value="@("hair")" Class="h-auto flex-col gap-1 py-2">
                            <LucideIcon Name="brush" Size="20" />
                            <span class="text-xs font-medium">@Loc["Hair"]</span>
                        </BbToggleGroupItem>
                        <BbToggleGroupItem Value="@("body")" Class="h-auto flex-col gap-1 py-2">
                            <LucideIcon Name="person-standing" Size="20" />
                            <span class="text-xs font-medium">@Loc["Body"]</span>
                        </BbToggleGroupItem>
                        <BbToggleGroupItem Value="@("hands")" Class="h-auto flex-col gap-1 py-2">
                            <LucideIcon Name="hand" Size="20" />
                            <span class="text-xs font-medium">@Loc["Hands"]</span>
                        </BbToggleGroupItem>
                        <BbToggleGroupItem Value="@("perfume")" Class="h-auto flex-col gap-1 py-2">
                            <LucideIcon Name="spray-can" Size="20" />
                            <span class="text-xs font-medium">@Loc["Perfume"]</span>
                        </BbToggleGroupItem>
                    </BbToggleGroup>
                    <ValidationMessage For="@(() => _state.Input.Category)" class="text-sm text-destructive" />
                </div>

                @* Expiry *@
                <BbField>
                    <BbFieldLabel Class="text-sm font-medium">@Loc["DurationAndExpiry"]</BbFieldLabel>
                    <BbFieldContent>
                        <BbDatePicker @bind-Value="_state.Input.ExpiryDate"
                                      MinDate="@(Item is null ? DateTime.Today : null)" DateFormat="dd/MM/yyyy"
                                      Placeholder="@Loc["PickADate"]" Class="w-full" />
                        <ValidationMessage For="@(() => _state.Input.ExpiryDate)" class="text-sm text-destructive" />
                    </BbFieldContent>
                </BbField>

                <div class="space-y-2">
                    <span class="text-xs text-muted-foreground">@Loc["Shortcuts"]</span>
                    <div class="flex flex-wrap gap-1.5">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Button"
                                  OnClick="@(() => SetExpiry(3))">@Loc["Shortcut3Days"]</BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Button"
                                  OnClick="@(() => SetExpiry(7))">@Loc["Shortcut1Week"]</BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Button"
                                  OnClick="@(() => SetExpiry(30))">@Loc["Shortcut1Month"]</BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Button"
                                  OnClick="@(() => SetExpiry(182))">@Loc["Shortcut6Months"]</BbButton>
                    </div>
                    <BbBadge Variant="@Banner.Variant">
                        <BbBadgeIcon Name="@Banner.Icon" />
                        @Banner.Text
                    </BbBadge>
                </div>

                @* Notes *@
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <BbLabel For="batch-notes" Class="text-sm font-medium">@Loc["BatchNotes"]</BbLabel>
                        <span class="text-xs text-muted-foreground">@Loc["Optional"]</span>
                    </div>
                    <BbTextarea Id="batch-notes" @bind-Value="_state.Input.Notes"
                                Placeholder="e.g. Nivea, blue label, opened" rows="2" />
                </div>
            </div>

            <div class="flex-none space-y-1 border-t pt-3">
                <BbButton Type="ButtonType.Submit" Class="w-full" Loading="@_state.Saving"
                          IconPosition="IconPosition.Start">
                    <Icon>
                        <LucideIcon Name="save" Size="16" />
                    </Icon>
                    <ChildContent>@(Item is null ? Loc["SaveItem"] : Loc["SaveChanges"])</ChildContent>
                </BbButton>
                <BbButton Variant="ButtonVariant.Ghost" Class="w-full" Type="ButtonType.Button"
                          OnClick="() => Sheet.CloseAsync()">
                    @Loc["Cancel"]
                </BbButton>
            </div>
        </EditForm>
    </div>

@code
{
    /// <summary>When set, the form edits this item instead of creating a new one.</summary>
    [Parameter]
    public CosmeticItemDto? Item { get; set; }

    private ExpiryHelper.ExpiryBanner Banner => ExpiryHelper.GetBanner(
        DateOnly.FromDateTime((_state.Input.ExpiryDate ?? DateTime.Today.AddDays(7)).Date),
        DateOnly.FromDateTime(DateTime.Today),
        Loc);

    protected override void OnParametersSet()
    {
        if (Item is { } item)
        {
            // Resync when a different item arrives or the same item changed
            // underneath (realtime edit elsewhere). In-progress typing never
            // triggers this: typing mutates Input, not the Item parameter.
            if (Equals(_state.SyncedItem, item))
                return;

            _state.SyncedItem = item;
            _state.EditingId = item.Id;
            _state.ScannedBarcode = item.Barcode;
            _state.Input = new InputModel
            {
                Name = item.Name,
                Quantity = item.Quantity,
                Unit = item.Unit,
                Category = item.Category,
                Notes = item.Notes,
                ExpiryDate = item.ExpiryDate.ToDateTime(TimeOnly.MinValue)
            };
        }
        else if (_state.SyncedItem is not null)
        {
            _state.SyncedItem = null;
            _state.EditingId = null;
            _state.ScannedBarcode = null;
            _state.Input = new InputModel();
        }
    }

    private async Task OnBarcodeScannedAsync(string barcode)
    {
        if (string.IsNullOrWhiteSpace(barcode))
            return;

        _state.LookingUp = true;
        StateHasChanged();

        try
        {
            var product = await ProductLinking.LookupAsync(Api, Toasts, Logger, Loc, barcode);
            if (product is null)
                return;

            // Pre-fill form with product data
            if (!string.IsNullOrWhiteSpace(product.Name))
                _state.Input.Name = product.Name;

            _state.Input.Notes = ProductNoteMerger.Merge(_state.Input.Notes, product.Brand);

            if (product.Quantity.HasValue && product.Quantity.Value > 0)
                _state.Input.Quantity = product.Quantity.Value;

            if (!string.IsNullOrWhiteSpace(product.Unit))
                _state.Input.Unit = product.Unit;

            // Store the barcode for saving
            _state.ScannedBarcode = product.Barcode;

            StateHasChanged();
        }
        finally
        {
            _state.LookingUp = false;
            StateHasChanged();
        }
    }

    private void IncrementQuantity()
    {
        if (_state.Input.Quantity < 9999)
            _state.Input.Quantity++;
    }

    private void DecrementQuantity()
    {
        if (_state.Input.Quantity > 0)
            _state.Input.Quantity--;
    }

    private void SetExpiry(int daysFromToday)
    {
        _state.Input.ExpiryDate = DateTime.Today.AddDays(daysFromToday);
    }

    private async Task HandleSubmitAsync()
    {
        if (_state.Input.ExpiryDate is null)
            return;

        _state.Saving = true;
        StateHasChanged();
        try
        {
            // Closing with the saved row lets the opener patch the list in
            // place; a bare "saved" marker forces it to refetch everything.
            CosmeticItemDto? saved = null;

            if (Item is null)
            {
                using var response = await Api.Cosmetics.CreateAsync(new CreateCosmeticItemRequest(
                    _state.Input.Name.Trim(),
                    _state.Input.Quantity,
                    _state.Input.Unit,
                    _state.Input.Category,
                    string.IsNullOrWhiteSpace(_state.Input.Notes) ? null : _state.Input.Notes.Trim(),
                    DateOnly.FromDateTime(_state.Input.ExpiryDate.Value),
                    _state.ScannedBarcode),
                    Members.CurrentMemberId);

                saved = await HandleSavedAsync(response, Loc["ItemAdded"]);
            }
            else
            {
                using var response = await Api.Cosmetics.UpdateAsync(Item.Id, new UpdateCosmeticItemRequest(
                    _state.Input.Name.Trim(),
                    _state.Input.Quantity,
                    _state.Input.Unit,
                    _state.Input.Category,
                    string.IsNullOrWhiteSpace(_state.Input.Notes) ? null : _state.Input.Notes.Trim(),
                    DateOnly.FromDateTime(_state.Input.ExpiryDate.Value),
                    _state.ScannedBarcode));

                saved = await HandleSavedAsync(response, Loc["ItemUpdated"]);
            }

            if (saved is null)
                return;

            await Sheet.CloseAsync(saved);
        }
        finally
        {
            _state.Saving = false;
        }
    }

    /// <summary>Returns the saved row, or null when the write failed.</summary>
    private async Task<T?> HandleSavedAsync<T>(ApiResponse<T> response, string successMessage)
    {
        if (response.IsSuccessStatusCode)
        {
            Toasts.Success(successMessage);
            return response.Content;
        }

        var errors = await ApiErrors.ReadValidationErrorsAsync(response.Error);
        if (errors is not null)
        {
            _state.CustomValidator?.DisplayErrors(errors);
            return default;
        }

        Logger.LogWarning("Save failed with {StatusCode}", response.StatusCode);
        Toasts.Error(Loc["CouldNotSave"]);
        return default;
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Range(0, 9999)]
        public double Quantity { get; set; } = 1;

        [Required]
        public string Unit { get; set; } = "pcs";

        [Required]
        public string Category { get; set; } = "face";

        [Required]
        public DateTime? ExpiryDate { get; set; } = DateTime.Today.AddDays(7);

        [StringLength(2000)]
        public string? Notes { get; set; }
    }
}