@namespace Client.Components
@using BlazorBlueprint.Primitives.SwipeArea

<div class="pointer-fine:hidden">
    <BbSwipeArea Axis="SwipeAxis.Horizontal" TouchAction="SwipeTouchAction.PanY" OnSwipe="HandleSwipe"
                 OnSwipeMove="HandleMove" OnSwipeCancel="HandleCancel">
        <div class="relative overflow-hidden rounded-md border bg-card">
            <div class="absolute inset-y-0 right-0 flex items-stretch">
                <CascadingValue Value="this" IsFixed="true">
                    <CascadingValue Value="false" Name="CompactActions" IsFixed="true">
                        @Actions
                    </CascadingValue>
                </CascadingValue>
            </div>
            <div @onclick="HandleTap" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="true"
                 tabindex="0" role="button" aria-label="@AriaLabel"
                 class="@($"relative w-full cursor-pointer bg-background p-3 text-left focus-visible:outline-2 {InnerClass}")"
                 style="transform: translateX(@_offsetPx); transition: @(_dragging ? "none" : "transform 150ms");">
                @ChildContent
            </div>
        </div>
    </BbSwipeArea>
</div>

<div class="hidden pointer-fine:block">
    <div class="rounded-md border bg-card p-3">
        <div class="flex items-center gap-2">
            <div @onclick="HandleTapStatic" @onkeydown="HandleKeyDownStatic" @onkeydown:preventDefault="true"
                 tabindex="0" role="button" aria-label="@AriaLabel"
                 class="min-w-0 flex-1 cursor-pointer focus-visible:outline-2">
                @ChildContent
            </div>
            <div class="flex shrink-0 items-center gap-1">
                <CascadingValue Value="true" Name="CompactActions" IsFixed="true">
                    @Actions
                </CascadingValue>
            </div>
        </div>
    </div>
</div>

@code
{
    /// <summary>Row body content.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Revealed action buttons (use <see cref="SwipeActionButton"/>).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Tap on the row body.</summary>
    [Parameter]
    public EventCallback OnTap { get; set; }

    /// <summary>Accessible name of the row body.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Extra layout classes for the swipe-mode row body (e.g. "block", "flex items-center gap-3").</summary>
    [Parameter]
    public string? InnerClass { get; set; } = "block";

    /// <summary>Total revealed width in px; must equal the sum of the action widths.</summary>
    [Parameter, EditorRequired]
    public double ActionsWidth { get; set; }

    private double _offset;
    private bool _dragging;
    private bool _open;

    private string _offsetPx => _offset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    protected override void OnParametersSet()
    {
        // The action set can shrink under a preserved row (same @key with new
        // params after a reload, e.g. mark-read dropping a button): any offset
        // outside the new range is stale, so snap fully shut.
        if (_offset < -ActionsWidth || _offset > 0)
        {
            _offset = 0;
            _open = false;
        }
    }

    private void HandleMove(SwipeMoveEventArgs e)
    {
        _dragging = true;
        _offset = Math.Clamp(e.DeltaX, -ActionsWidth, 0);
    }

    private void HandleSwipe(SwipeEventArgs e)
    {
        _dragging = false;

        if (e.Direction == SwipeDirection.Left)
        {
            _open = true;
            _offset = -ActionsWidth;
        }
        else
        {
            _open = false;
            _offset = 0;
        }
    }

    private void HandleCancel()
    {
        _dragging = false;
        _offset = _open ? -ActionsWidth : 0;
    }

    /// <summary>Closes revealed actions, if any.</summary>
    public void CloseActions()
    {
        _open = false;
        _offset = 0;
        StateHasChanged();
    }

    private async Task HandleTap()
    {
        if (_open)
        {
            CloseActions();
            return;
        }

        await OnTap.InvokeAsync();
    }

    private Task HandleTapStatic()
        => OnTap.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await HandleTap();
    }

    private async Task HandleKeyDownStatic(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await OnTap.InvokeAsync();
    }
}
