@page "/"

@inject ServerApi Api
@inject BottomSheetService Sheet
@inject DialogService Dialogs
@inject ToastService Toasts
@inject ILogger<Home> Logger
@inject LocalizationService Loc
@inject PantryRealtimeService Realtime
@implements IDisposable

<header class="flex items-center justify-between gap-2">
    <div class="min-w-0">
        <h1 class="truncate text-xl font-semibold">@Loc["AppTitle"]</h1>
        @if (_state.Total > 0)
        {
            <p class="truncate text-sm text-muted-foreground">@Loc["ItemsCount", _state.Total]</p>
        }
    </div>
    <div class="flex flex-none items-center gap-2">
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="@Loc["AddItem"]"
                  @onclick="OpenAddAsync">
            <LucideIcon Name="plus" Size="18" />
        </BbButton>
        <NotificationsBellButton />
        <MemberAvatarButton />
    </div>
</header>

<div class="flex gap-2">
    <div class="flex-1">
        <BbInputGroup>
            <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                <LucideIcon Name="search" Size="16" />
            </BbInputGroupAddon>
            <BbInputGroupInput @bind-Value="_state.Name" @bind-Value:after="OnSearchInput"
                               Placeholder="@Loc["SearchPlaceholder"]" />
        </BbInputGroup>
    </div>
    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" AriaLabel="@Loc["Filters"]"
              @onclick="OpenFiltersAsync">
        <LucideIcon Name="sliders-horizontal" Size="16" />
        @if (HasFilters)
        {
            <span class="h-2 w-2 rounded-full bg-primary"></span>
        }
    </BbButton>
</div>

<PullToRefresh OnRefresh="ReloadListAsync">
    <InfiniteScrollList TItem="PantryItemDto" @ref="_state.List" LoadPageAsync="LoadPageAsync"
                        KeySelector="PantryKey" TotalChanged="OnTotalChanged">
        <ItemTemplate>
            <PantryItemRow Item="context" Today="_state.Today"
                           OnOpen="OpenDetailsForItem"
                           OnChanged="UpsertItemAsync" />
        </ItemTemplate>
        <LoadingTemplate>
            <div class="space-y-2" aria-hidden="true">
                <BbSkeleton Height="64px" Class="w-full" />
                <BbSkeleton Height="64px" Class="w-full" />
                <BbSkeleton Height="64px" Class="w-full" />
            </div>
        </LoadingTemplate>
        <EmptyTemplate>
            <BbEmpty Title="@Loc["NoItemsFound"]" Description="@Loc["NoItemsDescription"]">
                <Icon>
                    <LucideIcon Name="search" Size="24" />
                </Icon>
                <ChildContent>
                    <BbButton Variant="ButtonVariant.Outline" @onclick="OpenAddAsync">
                        <LucideIcon Name="plus" Size="16" />
                        @Loc["AddItemButton"]
                    </BbButton>
                </ChildContent>
            </BbEmpty>
        </EmptyTemplate>
    </InfiniteScrollList>
</PullToRefresh>

@code
{
    private bool HasFilters =>
        _state.Location != PantryLocations.All || _state.Status != PantryRules.StatusAll || _state.Sort != ItemSort.ExpiryAsc;

    private void OnTotalChanged(int total) => _state.Total = total;

    private static object? PantryKey(PantryItemDto item) => item.Id;

    private Task OpenDetailsForItem(PantryItemDto item) => OpenDetailsAsync(item.Id);

    protected override async Task OnInitializedAsync()
    {
        Realtime.Changed += OnRealtimeChanged;
        await Realtime.StartAsync();
    }

    private Task OnRealtimeChanged(PantryChangedEvent change) => InvokeAsync(() => HandleChangeAsync(change));

    /// <summary>
    /// Patches the loaded rows instead of refetching the whole list: drops
    /// removals, replaces visible updates, and inserts creates at their sorted
    /// position. Anything uncertain falls back to a full reload.
    /// </summary>
    private async Task HandleChangeAsync(PantryChangedEvent change)
    {
        if (_state.List is null)
            return;

        try
        {
            switch (change.ChangeKind)
            {
                case PantryChangeKind.Removed:
                    await _state.List.RemoveByKeyAsync(change.ItemId);
                    break;
                default:
                    await UpsertItemAsync(change.ItemId);
                    break;
            }
        }
        catch (Exception ex)
        {
            // A patch must never break the list: fall back to a full reload.
            Logger.LogWarning(ex, "Granular pantry update failed; reloading.");
            await ReloadListAsync();
        }
    }

    private async Task UpsertItemAsync(string id)
    {
        var list = _state.List;
        if (list is null)
            return;

        PantryItemDto item;
        try
        {
            using var response = await Api.Pantry.GetByIdAsync(id);
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                await list.RemoveByKeyAsync(id);
                return;
            }
            if (!response.IsSuccessfulWithContent || response.Content is null)
            {
                await ReloadListAsync();
                return;
            }
            item = response.Content;
        }
        catch
        {
            await ReloadListAsync();
            return;
        }

        if (!MatchesFilters(item))
        {
            await list.RemoveByKeyAsync(id);
            return;
        }

        if (await list.ReplaceAsync(item))
            return;

        if (list.IsFullyLoaded)
            await list.InsertSortedAsync(item, CurrentComparer);
        else
            await ReloadListAsync();
    }

    /// <summary>Mirrors the server query: exact location, substring name, derived status.</summary>
    private bool MatchesFilters(PantryItemDto item)
        => PantryClientFilter.MatchesFilters(item, _state.Location, _state.Name, _state.Status, _state.Today);

    /// <summary>Mirrors the server ordering; any drift self-corrects on the next full reload.</summary>
    private Comparison<PantryItemDto> CurrentComparer => PantryClientFilter.GetComparer(_state.Sort);

    private async Task<Page<PantryItemDto>> LoadPageAsync(int skip, int take, CancellationToken ct)
    {
        var request = new GetPantryItemsRequest
        {
            Location = _state.Location,
            Name = _state.Name,
            Status = _state.Status == PantryRules.StatusAll ? null : _state.Status,
            Sort = _state.Sort switch
            {
                ItemSort.ExpiryDesc => PantryRules.SortExpiryDesc,
                ItemSort.Name => PantryRules.SortName,
                _ => PantryRules.SortExpiryAsc
            },
            Skip = skip,
            Take = take
        };

        using var response = await Api.Pantry.GetAsync(request, ct);

        if (!response.IsSuccessfulWithContent)
        {
            Logger.LogWarning("Pantry list load failed with {StatusCode}", response.StatusCode);
            throw new HttpRequestException($"Pantry list load failed with {response.StatusCode}.");
        }

        // An empty-but-successful body is an empty page, not a crash.
        var content = response.Content;
        return content is null
            ? new Page<PantryItemDto>([], 0)
            : new Page<PantryItemDto>(content.Items.ToList(), content.TotalItems);
    }

    private async Task OpenAddAsync()
    {
        var result = await Sheet.OpenAsync<ItemForm>();
        if (!result.Cancelled)
            await ReloadListAsync();
    }

    private async Task OpenDetailsAsync(string id)
    {
        var parameters = new Dictionary<string, object?>
        {
            ["ItemId"] = id
        };
        
        var result = await Sheet.OpenAsync<ItemDetailsBody>(parameters);
        await ItemDeletion.HandleAsync(result, Api, Dialogs, Toasts, Logger, Loc);
        if (!result.Cancelled)
            await ReloadListAsync();
    }

    private async Task OpenFiltersAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Location"] = _state.Location,
            ["Status"] = _state.Status,
            ["Sort"] = _state.Sort
        };

        var result = await Sheet.OpenAsync<FilterSheetBody>(parameters);

        if (result.Cancelled)
            return;

        var data = result.GetData<FilterSheetBody.SelectedFilters>();

        if (data is not { } filters)
            return;

        (_state.Location, _state.Status, _state.Sort) = (filters.Location, filters.Status, filters.Sort);
        await ReloadListAsync();
    }

    private Task ReloadListAsync()
        => _state.List is not null ? _state.List.ReloadAsync() : Task.CompletedTask;

    /// <summary>Debounced search: one reload per pause in typing, not per keystroke.</summary>
    private void OnSearchInput()
    {
        _state.SearchCts?.Cancel();
        _state.SearchCts?.Dispose();
        _state.SearchCts = new CancellationTokenSource();
        _ = DebouncedReloadAsync(_state.SearchCts.Token);
    }

    private async Task DebouncedReloadAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(300, ct);
            await InvokeAsync(ReloadListAsync);
        }
        catch (OperationCanceledException)
        {
            // Superseded by newer input; nothing to do.
        }
    }

    public void Dispose()
    {
        Realtime.Changed -= OnRealtimeChanged;
        _state.SearchCts?.Cancel();
        _state.SearchCts?.Dispose();
    }
}