@page "/"

@inject ServerApi Api
@inject BottomSheetService Sheet
@inject DialogService Dialogs
@inject ToastService Toasts
@inject ILogger<Home> Logger

<header class="flex items-center justify-between gap-2">
    <h1 class="text-xl font-semibold">Smart Pantry</h1>
    <div class="flex items-center gap-2">
        @if (_total > 0)
        {
            <span class="text-sm text-muted-foreground">@_total items</span>
        }
        <NotificationsBellButton />
        <MemberAvatarButton />
    </div>
</header>

<div class="flex gap-2">
    <div class="flex-1">
        <BbInputGroup>
            <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                <LucideIcon Name="search" Size="16" />
            </BbInputGroupAddon>
            <BbInputGroupInput @bind-Value="_name" @bind-Value:after="ReloadListAsync"
                               Placeholder="Search pantry items..." />
        </BbInputGroup>
    </div>
    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" AriaLabel="Open filters"
              @onclick="OpenFiltersAsync">
        <LucideIcon Name="sliders-horizontal" Size="16" />
        @if (HasFilters)
        {
            <span class="h-2 w-2 rounded-full bg-primary"></span>
        }
    </BbButton>
</div>

<InfiniteScrollList TItem="PantryItemDto" @ref="_list" LoadPageAsync="LoadPageAsync" KeySelector="@(x => x.Id)"
                    TotalChanged="OnTotalChanged">
    <ItemTemplate>
        @{
            var status = ExpiryHelper.GetStatus(context.ExpirationDate, _today);
        }
        <button type="button" @onclick="() => OpenDetailsAsync(context.Id)"
                class="bg-card block w-full rounded-md border p-3 text-left">
            <span class="flex items-center justify-between gap-2">
                <span class="font-medium">@context.Name</span>
                <BbBadge Variant="@ExpiryHelper.Badge(status)">@ExpiryHelper.Label(status)</BbBadge>
            </span>
            <span class="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
                <span>@context.Quantity @context.Unit</span>
                <BbBadge Variant="BadgeVariant.Outline">@context.Location</BbBadge>
                <span>@context.ExpirationDate.ToString("MMM d")</span>
            </span>
        </button>
    </ItemTemplate>
    <LoadingTemplate>
        <div class="space-y-2" aria-hidden="true">
            <BbSkeleton Height="64px" Class="w-full" />
            <BbSkeleton Height="64px" Class="w-full" />
            <BbSkeleton Height="64px" Class="w-full" />
        </div>
    </LoadingTemplate>
    <EmptyTemplate>
        <BbEmpty Title="No items found" Description="Try clearing filters or add one">
            <Icon>
                <LucideIcon Name="search" Size="24" />
            </Icon>
            <ChildContent>
                <BbButton Variant="ButtonVariant.Outline" @onclick="OpenAddAsync">
                    <LucideIcon Name="plus" Size="16" />
                    Create
                </BbButton>
            </ChildContent>
        </BbEmpty>
    </EmptyTemplate>
</InfiniteScrollList>

<BbFab AriaLabel="Add item" Class="bottom-24 md:bottom-6" OnClick="OpenAddAsync">
    <Icon>
        <LucideIcon Name="plus" Size="24" />
    </Icon>
</BbFab>

@code
{
    private InfiniteScrollList<PantryItemDto>? _list;
    private int _total;

    private string? _location = PantryLocations.All, _name;
    private string _status = PantryRules.StatusAll;
    private ItemSort _sort = ItemSort.ExpiryAsc;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private bool HasFilters =>
        _location != PantryLocations.All || _status != PantryRules.StatusAll || _sort != ItemSort.ExpiryAsc;

    private void OnTotalChanged(int total) => _total = total;

    private async Task<Page<PantryItemDto>> LoadPageAsync(int skip, int take, CancellationToken ct)
    {
        var request = new GetPantryItemsRequest
        {
            Location = _location,
            Name = _name,
            Status = _status == PantryRules.StatusAll ? null : _status,
            Sort = _sort switch
            {
                ItemSort.ExpiryDesc => PantryRules.SortExpiryDesc,
                ItemSort.Name => PantryRules.SortName,
                _ => PantryRules.SortExpiryAsc
            },
            Skip = skip,
            Take = take
        };

        using var response = await Api.Pantry.GetAsync(request, ct);

        if (!response.IsSuccessfulWithContent)
        {
            Logger.LogWarning("Pantry list load failed with {StatusCode}", response.StatusCode);
            throw new HttpRequestException($"Pantry list load failed with {response.StatusCode}.");
        }

        return new Page<PantryItemDto>(response.Content.Items.ToList(), response.Content.TotalItems);
    }

    private async Task OpenAddAsync()
    {
        await Sheet.OpenAsync<ItemForm>();
        await ReloadListAsync();
    }

    private async Task OpenDetailsAsync(string id)
    {
        var parameters = new Dictionary<string, object?> { ["ItemId"] = id };
        var result = await Sheet.OpenAsync<ItemDetailsBody>(parameters);
        await ItemDeletion.HandleAsync(result, Api, Dialogs, Toasts, Logger);
        await ReloadListAsync();
    }

    private async Task OpenFiltersAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Location"] = _location,
            ["Status"] = _status,
            ["Sort"] = _sort
        };

        var result = await Sheet.OpenAsync<FilterSheetBody>(parameters);

        if (result.Cancelled)
            return;

        var data = result.GetData<FilterSheetBody.SelectedFilters>();

        if (data is not { } filters)
            return;

        (_location, _status, _sort) = (filters.Location, filters.Status, filters.Sort);
        await ReloadListAsync();
    }

    private Task ReloadListAsync()
        => _list is not null ? _list.ReloadAsync() : Task.CompletedTask;
}
