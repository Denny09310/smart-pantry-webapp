@page "/pantry"
@using Client.Components.Shared.Home
@using Client.Components.Shared.Pantry
@using DataGridPrimitives = BlazorBlueprint.Primitives.DataGrid

@inject ServerApi Api
@inject ToastService Toast
@inject DialogService Dialog
@inject BottomSheetService BottomSheet
@inject MemberService Members
@inject PantryRealtimeService Realtime
@inject ILogger<Pantry> Log
@inject IStringLocalizer<UIStrings> L
@implements IDisposable

<div class="mx-auto w-full max-w-6xl space-y-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                @L["Pantry_Eyebrow"]
                @if (CriticalCount > 0)
                {
                    <span class="text-destructive">@L["Pantry_UrgentBadge", CriticalCount]</span>
                }
            </p>
            <h1 class="text-2xl font-semibold">@L["Pantry_Title"]</h1>
        </div>
        <PantrySummary TotalItems="@TotalCount" CriticalCount="@CriticalCount" SoonCount="@SoonCount"
                       ExpiredCount="@ExpiredCount" />
    </div>

    <PantryFilterBar Search="@_name" SearchChanged="@OnSearchChanged" Location="@_location"
                     LocationChanged="@OnLocationChanged" Status="@_status" StatusChanged="@OnStatusChanged" Locations="@Locations"
                     LocationCounts="@LocationCounts" TotalCount="@TotalCount" SoonCount="@SoonCount" TodayCount="@TodayCount"
                     ExpiredCount="@ExpiredCount" FreshCount="@FreshCount" OnAdd="@CreateItemAsync" />

    @if (_counts is null && !_countsFailed)
    {
        <div class="flex justify-center py-12">
            <BbSpinner Size="SpinnerSize.Large" />
        </div>
    }
    else if (_counts is null)
    {
        <BbEmpty Title="@L["Common_LoadError"]" Description="@L["Common_NoMatchesHint"]" Size="EmptySize.Default">
            <Icon>
                <LucideIcon Name="triangle-alert" Size="28" />
            </Icon>
            <ChildContent>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RetryCountsAsync">
                    @L["Common_Retry"]
                </BbButton>
            </ChildContent>
        </BbEmpty>
    }
    else if (_counts.Total == 0)
    {
        <BbEmpty Title="@L["Common_EmptyTitle"]" Description="@L["Common_EmptyDescription"]"
                 Size="EmptySize.Default">
            <Icon>
                <LucideIcon Name="package" Size="28" />
            </Icon>
            <ChildContent>
                <BbButton Size="ButtonSize.Small" OnClick="CreateItemAsync">
                    <LucideIcon Name="plus" Size="14" />
                    @L["Common_AddItem"]
                </BbButton>
            </ChildContent>
        </BbEmpty>
    }
    else if (_filterTotal == 0)
    {
        <BbEmpty Title="@L["Common_NoMatches"]" Description="@L["Common_NoMatchesHint"]" Size="EmptySize.Default">
            <Icon>
                <LucideIcon Name="search" Size="28" />
            </Icon>
            <ChildContent>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ClearFilters">
                    @L["Common_ClearFilters"]
                </BbButton>
            </ChildContent>
        </BbEmpty>
    }
    else
    {
        <div class="hidden md:block">
            <PantryInventoryTable ItemsProvider="@ProvideTablePageAsync" FilterKey="@FilterKey" BusyIds="@_busyIds"
                                  OnEdit="@EditItemAsync" OnDelete="@DeleteItemAsync" OnDetails="@OpenDetailsAsync" />
            <div class="flex items-center justify-between gap-2 px-1 pt-2 text-xs text-muted-foreground">
                <p>@L["Pantry_Showing", _filterTotal ?? TotalCount]</p>
                <p>@L["Pantry_SortHint"]</p>
            </div>
        </div>

        <div class="space-y-3 md:hidden">
            <div class="flex items-start justify-between gap-2">
                <div>
                    <h2 class="text-base font-semibold">@L["Pantry_ItemsHeading"]</h2>
                    <p class="text-xs text-muted-foreground">@L["Pantry_ItemsSubtext", _filterTotal ?? TotalCount]</p>
                </div>
                <BbBadge Variant="BadgeVariant.SoftInfo">@L["Common_SortedBadge"]</BbBadge>
            </div>

            <PantryUrgentList ItemsProvider="@ProvideItemsAsync" ResetKey="@FilterKey" TotalChanged="@OnTotalChanged"
                              BusyIds="@_busyIds" OnCheck="@MarkUsedAsync" OnEdit="@EditItemAsync"
                              OnDelete="@DeleteItemAsync" OnBarcodeAttached="@AttachBarcodeAsync" HighlightId="@_highlightId" />

            @if (HasActiveFilters)
            {
                <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick="ClearFilters">
                    @L["Pantry_ViewAll", TotalCount]
                    <LucideIcon Name="arrow-right" Size="14" />
                </BbButton>
            }

            <PantryTip />
        </div>
    }
</div>

@code
{
    private DialogOpenOptions CreateOptions() => new()
    {
        Title = L["Common_AddDialogTitle"],
        Description = L["Common_EmptyDescription"],
        Size = DialogSize.Large
    };

    private DialogOpenOptions EditOptions() => new()
    {
        Title = L["Pantry_EditTitle"],
        Description = L["Pantry_EditDescription"],
        Size = DialogSize.Large
    };

    private DialogOpenOptions DetailsOptions() => new()
    {
        Title = L["Pu_ActionsTitle"],
        Description = L["Pu_ActionsDescription"]
    };

    private PantryCounts? _counts;
    private bool _countsFailed;
    private int? _filterTotal;
    private int _refreshTick;
    private readonly HashSet<string> _busyIds = [];
    private string? _highlightId;

    private string? _location = "all", _name;
    private PantryStatusFilter _status = PantryStatusFilter.All;

    private string FilterKey => $"{_name}|{_location}|{_status}|{_refreshTick}";

    private string? QueryLocation => _location is "all" or null ? null : _location;

    private string? QueryName => string.IsNullOrWhiteSpace(_name) ? null : _name;

    private int TotalCount => _counts?.Total ?? 0;

    private int ExpiredCount => _counts?.Expired ?? 0;

    private int TodayCount => _counts?.Today ?? 0;

    private int SoonCount => _counts?.Soon ?? 0;

    private int FreshCount => _counts?.Fresh ?? 0;

    private int CriticalCount => ExpiredCount + TodayCount;

    private IReadOnlyList<string> Locations
        => _counts?.ByLocation
            .Where(kv => kv.Value > 0)
            .Select(kv => kv.Key)
            .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private IReadOnlyDictionary<string, int> LocationCounts
        => _counts?.ByLocation as IReadOnlyDictionary<string, int>
            ?? System.Collections.Frozen.FrozenDictionary<string, int>.Empty;

    protected override async Task OnInitializedAsync()
    {
        Realtime.Changed += OnRealtimeChanged;
        await Realtime.StartAsync();
        await LoadCountsAsync();
    }

    public void Dispose() => Realtime.Changed -= OnRealtimeChanged;

    private Task OnRealtimeChanged()
    {
        try
        {
            // Broadcasts are hints: re-query and converge, quietly —
            // the manual reload path reports its own errors.
            return InvokeAsync(async () =>
            {
                await LoadCountsAsync(quiet: true);
                _refreshTick++;
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Page is going away; nothing left to render.
            return Task.CompletedTask;
        }
    }

    private static ExpiryStatus? MapStatus(PantryStatusFilter filter) => filter switch
    {
        PantryStatusFilter.Soon => ExpiryStatus.Soon,
        PantryStatusFilter.Today => ExpiryStatus.Today,
        PantryStatusFilter.Expired => ExpiryStatus.Expired,
        PantryStatusFilter.Fresh => ExpiryStatus.Fresh,
        _ => null,
    };

    private async Task<InfiniteScrollList<PantryItemDto>.PageResult> ProvideItemsAsync(int skip, int take, CancellationToken ct)
    {
        try
        {
            return await ServerApiExtensions.GetPantryPageAsync(
                Api.Pantry,
                QueryLocation,
                QueryName,
                MapStatus(_status),
                false,
                false,
                skip,
                take,
                ct);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Pantry page load failed.");
            Toast.Error(L["Common_LoadError"]);
            return new([], _filterTotal ?? skip);
        }
    }

    private async ValueTask<DataGridPrimitives.DataGridResult<PantryItemDto>> ProvideTablePageAsync(DataGridPrimitives.DataGridRequest request)
    {
        request.CancellationToken.ThrowIfCancellationRequested();

        var descending = request.SortDefinitions is [{ Direction: var direction }, ..]
            && direction == SortDirection.Descending;

        try
        {
            var page = await ServerApiExtensions.GetPantryPageAsync(
                Api.Pantry,
                QueryLocation,
                QueryName,
                MapStatus(_status),
                false,
                descending,
                request.StartIndex,
                request.Count ?? 20,
                request.CancellationToken);

            return new()
            {
                Items = page.Items.ToList(),
                TotalItemCount = page.Total,
            };
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Pantry table load failed.");
            Toast.Error(L["Common_LoadError"]);
            return new() { Items = [], TotalItemCount = 0 };
        }
    }

    private Task OnTotalChanged(int total)
    {
        _filterTotal = total;
        return Task.CompletedTask;
    }

    private async Task LoadCountsAsync(bool quiet = false)
    {
        try
        {
            _counts = await ServerApiExtensions.GetPantryCountsAsync(Api.Pantry, CancellationToken.None);
            _countsFailed = false;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Pantry counts load failed.");

            if (!quiet)
                Toast.Error(L["Common_LoadError"]);

            if (_counts is null)
                _countsFailed = true;
        }
    }

    private async Task RetryCountsAsync() => await LoadCountsAsync();

    private void OnSearchChanged(string? value) => _name = value;

    private void OnLocationChanged(string? value) => _location = value;

    private void OnStatusChanged(PantryStatusFilter value) => _status = value;

    private void ClearFilters()
    {
        _name = null;
        _location = "all";
        _status = PantryStatusFilter.All;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_name)
        || (_location is not null && _location is not "all")
        || _status != PantryStatusFilter.All;

    private async Task RefreshDataAsync()
    {
        _highlightId = null;
        await LoadCountsAsync();
        _refreshTick++;
    }

    private async Task CreateItemAsync()
    {
        var result = await BottomSheet.OpenAsync<CreatePantryItemDialog>(CreateOptions());

        if (result.Cancelled)
            return;

        if (result.GetData<CreatePantryItemRequest>() is not { } request)
            return;

        using var response = await Api.Pantry.CreateAsync(request, Members.CurrentMemberId);

        if (!response.IsSuccessfulWithContent)
        {
            Toast.Error(L["Common_CreateError"]);
            return;
        }

        var createdId = response.Content?.Id;

        Toast.Success(L["Common_Created"]);
        await RefreshDataAsync();
        _highlightId = createdId;
    }

    private async Task EditItemAsync(PantryItemDto item)
    {
        var parameters = new Dictionary<string, object?> { [nameof(CreatePantryItemDialog.Item)] = item };
        var result = await BottomSheet.OpenAsync<CreatePantryItemDialog>(parameters, EditOptions());

        if (result.Cancelled)
            return;

        if (result.GetData<CreatePantryItemRequest>() is not { } request)
            return;

        var update = new UpdatePantryItemRequest(
            request.Name,
            request.Quantity,
            request.Unit,
            request.Location,
            request.Notes,
            request.ExpirationDate,
            request.Barcode ?? item.Barcode);

        if (!_busyIds.Add(item.Id))
            return;

        try
        {
            using var response = await Api.Pantry.UpdateAsync(item.Id, update);

            if (!response.IsSuccessfulWithContent)
            {
                Toast.Error(L["Common_UpdateError"]);
                return;
            }

            Toast.Success(L["Home_Updated", request.Name]);
            await RefreshDataAsync();
        }
        finally
        {
            _busyIds.Remove(item.Id);
        }
    }

    private async Task OpenDetailsAsync(PantryItemDto item)
    {
        var result = await BottomSheet.OpenAsync<PantryItemActionsDialog>(
            parameters: new Dictionary<string, object?>
            {
                [nameof(PantryItemActionsDialog.Item)] = item
            },
            DetailsOptions());

        if (result.Cancelled)
            return;

        if (result.GetData<PantryItemActionsDialog.Choice>() is not { } choice)
            return;

        switch (choice.Action)
        {
            case PantryItemActionsDialog.Result.Edit:
                await EditItemAsync(item);
                break;

            case PantryItemActionsDialog.Result.Delete:
                await DeleteItemAsync(item);
                break;

            case PantryItemActionsDialog.Result.Attach when choice.Barcode is not null:
                await AttachBarcodeAsync(new PantryUrgentList.BarcodeAttached(item, choice.Barcode));
                break;
        }
    }

    private async Task AttachBarcodeAsync(PantryUrgentList.BarcodeAttached attached)
    {
        var (item, barcode) = (attached.Item, attached.Barcode);

        if (!_busyIds.Add(item.Id))
            return;

        try
        {
            var update = new UpdatePantryItemRequest(
                item.Name,
                item.Quantity,
                item.Unit,
                item.Location,
                item.Notes,
                item.ExpirationDate,
                barcode);

            using var response = await Api.Pantry.UpdateAsync(item.Id, update);

            if (!response.IsSuccessfulWithContent)
            {
                Toast.Error(L["Common_UpdateError"]);
                return;
            }

            Toast.Success(L["Pd_Attached"]);
            await RefreshDataAsync();
        }
        finally
        {
            _busyIds.Remove(item.Id);
        }
    }

    private async Task DeleteItemAsync(PantryItemDto item)
    {
        var confirm = await Dialog.ConfirmAsync(
            L["Home_DeleteTitle", item.Name],
            L["Common_DeleteUndone"],
            new ConfirmDialogOptions { ConfirmText = L["Common_Delete"], CancelText = L["Common_Cancel"], Destructive = true });

        if (!confirm.Confirmed)
            return;

        if (!_busyIds.Add(item.Id))
            return;

        try
        {
            using var response = await Api.Pantry.DeleteAsync(item.Id);

            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(L["Common_DeleteError"]);
                return;
            }

            Toast.Success(L["Common_Removed", item.Name]);
            await RefreshDataAsync();
        }
        finally
        {
            _busyIds.Remove(item.Id);
        }
    }

    private async Task MarkUsedAsync(PantryItemDto item)
    {
        var confirm = await Dialog.ConfirmAsync(
            L["Pantry_MarkUsedTitle", item.Name],
            L["Pantry_MarkUsedDescription", item.Name],
            new ConfirmDialogOptions { ConfirmText = L["Pantry_MarkUsedButton"], CancelText = L["Common_Cancel"] });

        if (!confirm.Confirmed)
            return;

        if (!_busyIds.Add(item.Id))
            return;

        try
        {
            using var response = await Api.Pantry.DeleteAsync(item.Id);

            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(L["Common_UpdateError"]);
                return;
            }

            Toast.Success(L["Pantry_UsedUp", item.Name]);
            await RefreshDataAsync();
        }
        finally
        {
            _busyIds.Remove(item.Id);
        }
    }
}
