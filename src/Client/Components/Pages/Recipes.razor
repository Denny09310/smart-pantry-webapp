@page "/recipes"
@using Client.Resources
@inject ServerApi Api
@inject BottomSheetService Sheet
@inject ToastService Toasts
@inject LocalizationService Loc
@implements IDisposable

<div class="flex h-full flex-col gap-3">
    <div class="flex-none">
        <h1 class="text-xl font-semibold">@Loc["Recipes"]</h1>
    </div>

    <BbTagInput @bind-Tags="_tags" @bind-Tags:after="OnTagsChanged"
                Placeholder="@Loc["RecipeSearchPlaceholder"]"
                MaxTags="5" Clearable
                OnSearchSuggestions="SearchSuggestionsAsync"
                AriaLabel="@Loc["Recipes"]" />

    <div class="min-h-0 flex-1 touch-pan-y overflow-y-auto overscroll-contain py-1 pr-1">
        @if (_loading)
        {
            <div class="grid grid-cols-2 gap-3 md:grid-cols-3" aria-hidden="true">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="overflow-hidden rounded-xl border bg-card">
                        <BbSkeleton Height="120px" Class="w-full rounded-none" />
                        <div class="space-y-1.5 p-2.5">
                            <BbSkeleton Height="14px" Class="w-full" />
                            <BbSkeleton Height="14px" Class="w-2/3" />
                        </div>
                    </div>
                }
            </div>
        }
        else if (_meals.Count > 0)
        {
            <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
                @foreach (var meal in _meals)
                {
                    <button type="button" @onclick="() => OpenDetailsAsync(meal.Id)"
                            class="bg-card block w-full overflow-hidden rounded-xl border text-left transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-ring">
                        @if (!string.IsNullOrWhiteSpace(meal.Thumbnail))
                        {
                            <img src="@meal.Thumbnail" alt="" loading="lazy" class="aspect-square w-full object-cover" />
                        }
                        <span class="block space-y-1 p-2.5">
                            <span class="block min-h-10 text-sm font-medium leading-snug line-clamp-2">
                                @DisplayName(meal)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(meal.Area))
                            {
                                <BbBadge Variant="BadgeVariant.Outline">@meal.Area</BbBadge>
                            }
                        </span>
                    </button>
                }
            </div>
        }
        else if (_searched)
        {
            <BbEmpty Title="@Loc["NoRecipesFound"]" Description="@Loc["NoRecipesDescription"]">
                <Icon>
                    <LucideIcon Name="chef-hat" Size="24" />
                </Icon>
            </BbEmpty>
        }
    </div>
</div>

@code {
    private IReadOnlyList<string>? _tags;
    private List<RecipeSummaryDto> _meals = [];
    private bool _loading;
    private bool _searched;

    private string Lang => Loc.CurrentCulture.TwoLetterISOLanguageName;

    protected override void OnInitialized()
    {
        Loc.CultureChanged += OnCultureChanged;
    }

    public void Dispose()
    {
        Loc.CultureChanged -= OnCultureChanged;
    }

    private async void OnCultureChanged()
    {
        try
        {
            // Re-search so names come back in the new language.
            if (_tags?.Count > 0)
                await SearchAsync();
            else
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private Task OnTagsChanged() => SearchAsync();

    private async Task<IEnumerable<string>> SearchSuggestionsAsync(string query, CancellationToken ct)
    {
        if (query.Length < 2)
            return [];

        var response = await Api.Recipes.SuggestIngredientsAsync(query, Lang, ct);
        return response.IsSuccessfulWithContent && response.Content is { } content
            ? content.Ingredients
            : [];
    }

    private async Task SearchAsync()
    {
        if (_tags is not { Count: > 0 })
        {
            _meals = [];
            _searched = false;
            return;
        }

        _loading = true;
        try
        {
            var response = await Api.Recipes.SearchAsync(string.Join(",", _tags), Lang);
            if (response.IsSuccessfulWithContent && response.Content is { } content)
            {
                _meals = content.Meals.ToList();
                _searched = true;
            }
            else
            {
                Toasts.Error(Loc["SearchRecipesFailed"]);
            }
        }
        catch
        {
            Toasts.Error(Loc["SearchRecipesFailed"]);
        }
        finally
        {
            _loading = false;
        }
    }

    private string DisplayName(RecipeSummaryDto meal) => meal.TranslatedName ?? meal.Name;

    private Task OpenDetailsAsync(string id) =>
        Sheet.OpenAsync<RecipeDetailBody>(new Dictionary<string, object?> { ["MealId"] = id });
}
