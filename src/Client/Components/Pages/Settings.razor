@page "/settings"
@using Client.Models
@inject LocalizationService Loc
@inject MemberService Members
@inject BottomSheetService Sheet
@inject ToastService Toasts
@implements IDisposable

<div class="flex h-full flex-col">
    <div class="flex-none">
        <h1 class="text-xl font-semibold">@Loc["Settings"]</h1>
    </div>

    <div class="min-h-0 flex-1 touch-pan-y space-y-6 overflow-y-auto overscroll-contain py-1 pr-1">
        @* Language Section *@
        <section class="space-y-3">
            <h2 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">@Loc["Language"]</h2>
            <BbSelect TValue="string" Value="@Loc.CurrentCulture.Name" ValueChanged="@ChangeLanguageAsync"
                      Placeholder="@Loc["SelectLanguage"]">
                @foreach (var culture in LocalizationService.SupportedCultures)
                {
                    <BbSelectItem Value="@culture.Name">
                        <span class="flex items-center gap-2">
                            <span class="text-lg">@GetFlagEmoji(culture.Name)</span>
                            <span>@GetCultureDisplayName(culture.Name)</span>
                        </span>
                    </BbSelectItem>
                }
            </BbSelect>
        </section>

        @* User Section *@
        <section class="space-y-3">
            <h2 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">@Loc["User"]</h2>
            
            <BbField>
                <BbFieldLabel Class="text-sm font-medium">@Loc["CurrentUser"]</BbFieldLabel>
                <BbFieldContent>
                    @if (Members.CurrentMember is { } current)
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-muted/50 border">
                            <BbAvatar>
                                <BbAvatarFallback
                                    style="@($"background-color: {current.Color ?? MemberDisplay.DefaultColor}; color: {MemberDisplay.ForegroundFor(current.Color)}")">
                                    @MemberDisplay.Initials(current.DisplayName)
                                </BbAvatarFallback>
                            </BbAvatar>
                            <div class="min-w-0 flex-1">
                                <p class="font-medium">@current.DisplayName</p>
                                <p class="text-xs text-muted-foreground">@Loc["Current"]</p>
                            </div>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                      OnClick="OpenMemberManagerAsync" AriaLabel="@Loc["ChangeUser"]">
                                <LucideIcon Name="chevron-right" Size="18" />
                            </BbButton>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-muted/50 border">
                            <BbAvatar>
                                <BbAvatarFallback Class="text-muted-foreground">?</BbAvatarFallback>
                            </BbAvatar>
                            <p class="text-muted-foreground">@Loc["NoUserSelected"]</p>
                        </div>
                    }
                </BbFieldContent>
            </BbField>

            <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="OpenMemberManagerAsync">
                <LucideIcon Name="users" Size="18" class="mr-2" />
                @Loc["HouseholdMembers"]
            </BbButton>
        </section>
    </div>
</div>

@code
{
    protected override void OnInitialized()
    {
        Members.Changed += OnChanged;
        Loc.CultureChanged += OnCultureChanged;
    }

    public void Dispose()
    {
        Members.Changed -= OnChanged;
        Loc.CultureChanged -= OnCultureChanged;
    }

    private async void OnChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async void OnCultureChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task ChangeLanguageAsync(string cultureName)
    {
        await Loc.SetCultureAsync(cultureName);
        Toasts.Success(Loc["LanguageSelected", GetCultureDisplayName(cultureName)]);
    }

    private async Task OpenMemberManagerAsync()
    {
        await Sheet.OpenAsync<MemberSwitcher>();
    }

    private static string GetFlagEmoji(string cultureName)
    {
        return cultureName switch
        {
            "en-US" => "🇺🇸",
            "it-IT" => "🇮🇹",
            _ => "🏳️"
        };
    }

    private static string GetCultureDisplayName(string cultureName)
    {
        return cultureName switch
        {
            "en-US" => "English",
            "it-IT" => "Italiano",
            _ => cultureName
        };
    }
}