@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<main class="p-4 pb-28 space-y-4">
    @Body
</main>

<BbBottomNav Value="@_activeTab" AriaLabel="Primary">
    <BbBottomNavItem Value="pantry" Label="Pantry" Href="/">
        <Icon><LucideIcon Name="package" Size="20" /></Icon>
    </BbBottomNavItem>
    <BbBottomNavItem Value="dashboard" Label="Dashboard" Href="/dashboard">
        <Icon><LucideIcon Name="clock" Size="20" /></Icon>
    </BbBottomNavItem>
</BbBottomNav>

<!-- Required for portal-based components (Popover, Dialog, Select, etc.) -->
<BbPortalHost />

<!-- Required if you use ToastService to show toasts -->
<BbToastProvider />

<!-- Required if you use DialogService for programmatic confirm dialogs -->
<BbDialogProvider />

<!-- Global bottom sheet (BottomSheetService) -->
<BottomSheetProvider />

@code {
    private string _activeTab = "pantry";

    protected override void OnInitialized()
    {
        UpdateActiveTab();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveTab();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateActiveTab()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        _activeTab = path.StartsWith("dashboard", StringComparison.OrdinalIgnoreCase)
            ? "dashboard"
            : "pantry";
    }

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;
}
