@inherits LayoutComponentBase
@inject IStringLocalizer<UIStrings> L

<AppHeader />

<main class="space-y-4 p-4 pb-28 md:pb-16">
    @Body
</main>

<BottomNav />

<footer class="fixed inset-x-0 bottom-0 hidden border-t bg-card md:block">
    <div
        class="mx-auto flex w-full max-w-6xl items-center justify-between gap-2 px-4 py-2 text-xs text-muted-foreground">
        <p>@L["Layout_FooterBrand"]</p>
        <p>@L["Layout_FooterStatus"]</p>
    </div>
</footer>

<UpdateNotifier />

<ThemeInitializer />

<MemberInit />

<BbPortalHost />
<BbToastProvider />
<BbDialogProvider />
<BottomSheetProvider />