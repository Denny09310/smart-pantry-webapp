@page "/"
@using Client.Components.Shared.Home

@inject ServerApi Api
@inject DialogService Dialog
@inject ToastService Toast
@inject BottomSheetService BottomSheet

<header class="flex items-center justify-between gap-2">
    <h1 class="text-xl font-semibold">Smart Pantry</h1>
    <div class="inline-flex items-center gap-2">
        <BbButton Size="ButtonSize.Small" Class="h-8 min-w-16" @onclick="CreateItemAsync">
            Add
        </BbButton>
    </div>
</header>

<BbInputGroup>
    <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
        <LucideIcon Name="search" Size="16" />
    </BbInputGroupAddon>
    <BbInputGroupInput @bind-Value="_name" @bind-Value:after="LoadAsync" Placeholder="Search pantry items..." />
</BbInputGroup>

<BbChipSet @bind-Value="_location" @bind-Value:after="LoadAsync" Wrap="false" Class="scrollbar-none">
    <BbChip Value="@("all")">All locations</BbChip>
    <BbChip Value="@("fridge")">Fridge</BbChip>
    <BbChip Value="@("pantry")">Pantry</BbChip>
    <BbChip Value="@("freezer")">Freezer</BbChip>
    <BbChip Value="@("cabinet")">Cabinet</BbChip>
</BbChipSet>

@if (_items is null)
{
    <em>Loading...</em>
}
else if (_items.Count == 0)
{
    <p>No items in the pantry yet</p>
    <button type="button" @onclick="CreateItemAsync">Create one</button>
}
else
{
    <ul>
        @foreach (var item in _items)
        {
            <li @key="item.Id">@item.Name</li>
        }
    </ul>
}

@code
{
    private static readonly DialogOpenOptions DOptions = new()
    {
        Title = "Add pantry item",
        Description = "Track a new pantry batch and expiration date",
        Size = DialogSize.Large
    };

    private static readonly BottomSheetOptions BsOptions = new()
    {
        Title = "Add pantry item",
        @* Description = "Track a new pantry batch and expiration date", *@
    };

    private List<PantryItemDto>? _items;
    private int _totalItems;

    private string? _location = "all", _name;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var request = new GetPantryItemsRequest(_location, _name);
        using var response = await Api.Pantry.GetAsync(request);

        if (!response.IsSuccessfulWithContent)
        {
            Toast.Error("Can't retrieve data.");
            return;
        }

        var content = response.Content;

        _items = new(content.Items);
        _totalItems = content.TotalItems;
    }

    private async Task CreateItemAsync()
    {
        var result = await BottomSheet.OpenAsync<CreatePantryItemDialog>(BsOptions);

        if (result.Cancelled)
            return;

        if (result.GetData<CreatePantryItemRequest>() is not { } request)
            return;

        using var response = await Api.Pantry.CreateAsync(request);

        if (!response.IsSuccessfulWithContent)
        {
            Toast.Error("Can't create new item.");
            return;
        }

        _items?.Insert(0, response.Content);
        _totalItems++;
    }
}