@namespace Client.Components.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_visible)
{
    <div class="bs-overlay" @ref="_overlayRef" aria-hidden="true"></div>
    <section class="bs-sheet @Class" @ref="_sheetRef" role="dialog" aria-modal="true" aria-label="@Title"
             style="@(MaxWidth is null ? null : $"--bs-max-width: {MaxWidth}")">
        @if (ShowHandle)
        {
            <div class="bs-handle" @ref="_handleRef" aria-hidden="true">
                <span class="bs-handle__bar"></span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description) || ShowCloseButton)
        {
            <div class="bs-header">
                <div class="bs-header__text">
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <h2 class="bs-title">@Title</h2>
                    }
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <p class="bs-description">@Description</p>
                    }
                </div>
                @if (ShowCloseButton)
                {
                    <button type="button" class="bs-close" @onclick="DismissAsync" aria-label="Close sheet">
                        <LucideIcon Name="x" Size="18" />
                    </button>
                }
            </div>
        }
        <div class="bs-content">
            @ChildContent
        </div>
    </section>
}
