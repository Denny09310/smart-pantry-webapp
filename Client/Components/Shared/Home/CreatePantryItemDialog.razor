@using System.ComponentModel.DataAnnotations

<EditForm Model="@Input" OnValidSubmit="HandleSubmitAsync" class="flex flex-col overflow-hidden">
    <DataAnnotationsValidator />

    <div class="min-h-0 flex-1 space-y-4 overflow-y-auto overscroll-none pr-1">
        @* Item name *@
        <BbField IsInvalid="@(!context.IsValid(() => Input.Name))">
            <div class="flex items-center justify-between">
                <BbFieldLabel For="item-name" Class="text-sm font-medium">Item Name *</BbFieldLabel>
                <span class="text-xs text-muted-foreground">Required</span>
            </div>
            <BbFieldContent>
                <BbInputGroup Class="bg-card">
                    <BbInputGroupInput Id="item-name" @bind-Value="Input.Name"
                                       Placeholder="e.g. Tomato sauce, Whole milk" UpdateTiming="UpdateTiming.Immediate" />
                </BbInputGroup>
                <BbFieldError Errors="@context.GetValidationMessages(() => Input.Name)" />
            </BbFieldContent>
        </BbField>

        @* Quantity & measure *@
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <BbLabel Class="text-sm font-medium">Quantity &amp; Measure</BbLabel>
                <span class="text-xs text-sky-600">Step counter</span>
            </div>

            <div class="flex items-center justify-between rounded-lg bg-muted p-1">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Decrease quantity"
                          OnClick="DecrementQuantity">
                    <LucideIcon Name="minus" Size="16" />
                </BbButton>
                <div class="flex flex-col items-center leading-none">
                    <span class="text-base font-semibold">@Input.Quantity</span>
                    <span class="text-xs text-muted-foreground">@Input.Unit</span>
                </div>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Increase quantity"
                          OnClick="IncrementQuantity">
                    <LucideIcon Name="plus" Size="16" />
                </BbButton>
            </div>
            <ValidationMessage For="@(() => Input.Quantity)" class="text-sm text-destructive" />

            <BbChipSet @bind-Value="Input.Unit" Wrap="false" Class="gap-1.5 scrollbar-none">
                <BbChip Value="@("pcs")">pcs</BbChip>
                <BbChip Value="@("jar")">jar</BbChip>
                <BbChip Value="@("can")">can</BbChip>
                <BbChip Value="@("box")">box</BbChip>
                <BbChip Value="@("kg")">kg</BbChip>
                <BbChip Value="@("g")">g</BbChip>
                <BbChip Value="@("litre")">litre</BbChip>
            </BbChipSet>
            <ValidationMessage For="@(() => Input.Unit)" class="text-sm text-destructive" />
        </div>

        @* Storage location *@
        <div class="space-y-2">
            <BbLabel Class="text-sm font-medium">Storage Location</BbLabel>
            <BbToggleGroup @bind-Value="Input.Location" Type="ToggleGroupType.Single" Required="true"
                           Variant="ToggleVariant.Outline" Class="grid grid-cols-4 gap-2">
                <BbToggleGroupItem Value="@("pantry")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="package" Size="20" />
                    <span class="text-xs font-medium">Pantry</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem Value="@("fridge")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="refrigerator" Size="20" />
                    <span class="text-xs font-medium">Fridge</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem Value="@("freezer")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="snowflake" Size="20" />
                    <span class="text-xs font-medium">Freezer</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem Value="@("cabinet")" Class="h-auto flex-col gap-1 py-2">
                    <LucideIcon Name="archive" Size="20" />
                    <span class="text-xs font-medium">Cabinet</span>
                </BbToggleGroupItem>
            </BbToggleGroup>
            <ValidationMessage For="@(() => Input.Location)" class="text-sm text-destructive" />
        </div>

        @* Shelf life & expiry *@
        <BbField>
            <BbFieldLabel Class="text-sm font-medium">Shelf Life &amp; Expiry</BbFieldLabel>
            <BbFieldContent>
                <BbDatePicker @bind-Value="Input.ExpirationDate" MinDate="DateTime.Today" DateFormat="dd/MM/yyyy"
                              Placeholder="Pick a date" Class="w-full" />
                <ValidationMessage For="@(() => Input.ExpirationDate)" class="text-sm text-destructive" />
            </BbFieldContent>
        </BbField>

        <div class="space-y-2">
            <span class="text-xs text-muted-foreground">Add shortcuts</span>
            <div class="flex flex-wrap gap-1.5">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(3))">
                    +3 days
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(7))">
                    +1 week
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(30))">
                    +1 month
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SetExpiry(180))">
                    +6 months
                </BbButton>
            </div>
            @if (DaysRemaining is not null)
            {
                <BbBadge Variant="@FreshnessVariant">
                    <BbBadgeIcon Name="info" />
                    @FreshnessText
                </BbBadge>
            }
        </div>

        @* Batch notes *@
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <BbLabel For="batch-notes" Class="text-sm font-medium">Batch Notes</BbLabel>
                <span class="text-xs text-muted-foreground">Optional</span>
            </div>
            <BbTextarea Id="batch-notes" @bind-Value="Input.Notes" Placeholder="e.g. Arrabbiata, top shelf, opened"
                        rows="2" />
        </div>

    </div>

    @* Actions *@
    <div class="shrink-0 space-y-1 border-t pt-3">
        <BbButton Type="ButtonType.Submit" Class="w-full" Loading="@_saving" IconPosition="IconPosition.Start">
            <Icon>
                <LucideIcon Name="save" Size="16" />
            </Icon>
            <ChildContent>Save Item</ChildContent>
        </BbButton>
        <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick="CancelAsync">
            Cancel
        </BbButton>
    </div>
</EditForm>

@code
{
    [CascadingParameter]
    public IDialogReference DialogRef { get; set; } = default!;

    private bool _saving;
    private InputModel Input { get; set; } = new();

    private int? DaysRemaining =>
        Input.ExpirationDate is { } d ? (int?)(d.Date - DateTime.Today).Days : null;

    private string FreshnessText => DaysRemaining switch
    {
        null => string.Empty,
        < 0 => $"Expired {-DaysRemaining} days ago",
        0 => "Expires today",
        <= 3 => $"Use soon · {DaysRemaining} days left",
        var d => $"Fresh & Stable · {d} days remaining",
    };

    private BadgeVariant FreshnessVariant => DaysRemaining switch
    {
        null => BadgeVariant.SoftInfo,
        < 0 => BadgeVariant.SoftDestructive,
        <= 3 => BadgeVariant.SoftWarning,
        _ => BadgeVariant.SoftSuccess,
    };

    private void IncrementQuantity()
    {
        if (Input.Quantity < 9999)
            Input.Quantity++;
    }

    private void DecrementQuantity()
    {
        if (Input.Quantity > 1)
            Input.Quantity--;
    }

    private void SetExpiry(int daysFromToday) =>
        Input.ExpirationDate = DateTime.Today.AddDays(daysFromToday);

    private async Task HandleSubmitAsync()
    {
        if (Input.ExpirationDate is null)
            return;

        _saving = true;
        try
        {
            var request = new CreatePantryItemRequest(
                Input.Name.Trim(),
                Input.Quantity,
                Input.Unit,
                Input.Location,
                string.IsNullOrWhiteSpace(Input.Notes) ? null : Input.Notes.Trim(),
                DateOnly.FromDateTime(Input.ExpirationDate.Value));

            await DialogRef.CloseAsync(DialogResult.Ok(request));
        }
        finally
        {
            _saving = false;
        }
    }

    private Task CancelAsync() => DialogRef.CancelAsync();

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Give the batch a name.")]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Range(1, 9999)]
        public double Quantity { get; set; } = 1;

        [Required]
        public string Unit { get; set; } = "pcs";

        [Required]
        public string Location { get; set; } = "pantry";

        [Required(ErrorMessage = "Pick an expiry date.")]
        public DateTime? ExpirationDate { get; set; } = DateTime.Today.AddDays(7);

        [StringLength(500)]
        public string? Notes { get; set; }
    }
}
